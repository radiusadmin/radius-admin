# Downloads a second-factor provider build (SPEC section 29): %i is <provider>-<version>.
# Unprivileged; downloads only from the provider's fixed address (dl.duosecurity.com for Duo).
# A proxy: put HTTPS_PROXY=http://proxy.example.net:3128 in /etc/radius-admin/update.env
[Unit]
Description=radius-admin integration download: %i
Documentation=file:/opt/radius-admin/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radius-admin
Group=radius-admin
EnvironmentFile=-/etc/radius-admin/update.env
Environment=RADIUS_ADMIN_CONFIG=/etc/radius-admin/radius-admin.conf
Environment=PYTHONPATH=/opt/radius-admin/app
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/var/lib/radius-admin/integrations
ExecStart=/usr/bin/python3 -s -m radius_admin.integration_fetch %i
TimeoutStartSec=1800
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/radius-admin/integrations
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
InaccessiblePaths=-/etc/freeradius -/var/lib/radius-admin-helper -/etc/radius-admin/helper.conf -/var/lib/radius-admin/staging
