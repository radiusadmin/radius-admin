{
  "format": 1,
  "id": "generic-rfc",
  "label": "Generic (RFC standard attributes)",
  "description": "Standard attributes for devices without a profile of their own: RFC 3580 VLAN, a rule's role as Filter-Id, admin rights by Service-Type, MAB from wired ports and access points, Disconnect on UDP 3799 (RFC 5176). No standard re-authenticate or port bounce.",
  "status": "unverified",
  "reply": {
    "vlan": [
      {"attr": "Tunnel-Type", "op": ":=", "value": "VLAN"},
      {"attr": "Tunnel-Medium-Type", "op": ":=", "value": "IEEE-802"},
      {"attr": "Tunnel-Private-Group-Id", "op": ":=", "value": "{vlan}"}
    ],
    "admin_full": [
      {"attr": "Service-Type", "op": ":=", "value": "Administrative-User"}
    ],
    "role": [
      {"attr": "Filter-Id", "op": ":=", "value": "{role}"}
    ]
  },
  "mab": {
    "port_types": ["Ethernet", "Wireless-802.11"]
  },
  "coa": {
    "port": 3799,
    "identify": "session-and-mac",
    "send_nas_port_id": true,
    "reauth": null,
    "bounce": null,
    "disconnect": {"packet": "disconnect", "attrs": []}
  },
  "snmp": {
    "port_names": []
  },
  "setup": {
    "accounting": null,
    "coa": null,
    "mfa_timeout": null
  }
}
