# Minimal emulation of the Active Directory bits used by mods-available/ldap.
# TEST ONLY. OIDs under a private test arc. memberOf is provided by slapo-nestgroup.
attributetype ( 1.3.6.1.4.1.55555.1.1 NAME 'dNSHostName'
	EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
objectclass ( 1.3.6.1.4.1.55555.2.1 NAME 'computer' SUP top STRUCTURAL
	MUST cn MAY ( dNSHostName $ description $ userPassword ) )
objectclass ( 1.3.6.1.4.1.55555.2.2 NAME 'group' SUP top STRUCTURAL
	MUST cn MAY ( member $ description ) )
objectclass ( 1.3.6.1.4.1.55555.2.3 NAME 'serviceAccount' SUP top STRUCTURAL
	MUST cn MAY ( userPassword $ description ) )
# People, for EAP-TTLS with a directory password (mods-available/ldap_user)
attributetype ( 1.3.6.1.4.1.55555.1.2 NAME 'sAMAccountName'
	EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
attributetype ( 1.3.6.1.4.1.55555.1.3 NAME 'userPrincipalName'
	EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
objectclass ( 1.3.6.1.4.1.55555.2.4 NAME 'user' SUP top STRUCTURAL
	MUST cn MAY ( sAMAccountName $ userPrincipalName $ userPassword $ description ) )
