POLICY_FORBIDDEN = [
    (re.compile(r"\$-?INCLUDE", re.I), "$INCLUDE"),
    (re.compile(r"\$ENV", re.I), "$ENV"),
    (re.compile(r"\$TEMPLATE", re.I), "$TEMPLATE"),
    (re.compile(r"%\{\s*exec\s*:", re.I), "%{exec:"),
    (re.compile(r"Exec-Program", re.I), "Exec-Program"),
    # numeric attribute aliases resolve to ANY dictionary attribute, e.g. Attr-502 =
    # Exec-Program, Attr-503 = Exec-Program-Wait, Vendor-<n>-Attr-<m>: refuse them all
    (re.compile(r"(?<![A-Za-z0-9_-])Attr-\d", re.I), "numeric attribute alias Attr-<n>"),
    (re.compile(r"\bVendor-[\w-]*-Attr-\d", re.I), "numeric attribute alias Vendor-*-Attr-<n>"),
    (re.compile(r"-Attr-\d", re.I), "numeric attribute alias *-Attr-<n>"),
    (re.compile(r"`"), "backtick"),
    # defense in depth: rlm_exec instances shipped by FreeRADIUS and interpreter modules
    (re.compile(r"%\{\s*(echo|ntlm_auth|perl|python3?|ruby|lua)\s*:", re.I), "exec-type xlat"),
]

_CLIENT_OPEN = re.compile(r"^client[ \t]+([A-Za-z0-9._-]{1,63})[ \t]*\{$")
_PAIR = re.compile(r"^([a-z_0-9]+)[ \t]*=[ \t]*(.*?)$")
_CLIENT_KEYS = {"ipaddr", "ipv4addr", "ipv6addr", "secret", "shortname", "nas_type",
                "require_message_authenticator", "limit_proxy_state", "radius_admin_profile"}
_YNA = {"yes", "no", "auto"}


def check_text(data, what):
    if len(data) > MAX_STAGED:
        raise HelperError("%s file exceeds 1 MiB" % what)
    if b"\0" in data:
        raise HelperError("%s file contains NUL bytes" % what)
    try:
        text = data.decode("utf-8", "strict")
    except UnicodeDecodeError:
        raise HelperError("%s file is not valid UTF-8" % what)
    for ch in text:
        o = ord(ch)
        if (o < 0x20 and ch not in "\n\t") or o == 0x7f:
            raise HelperError("%s file contains control characters" % what)
    return text


def check_policy(data):
    text = check_text(data, "policy")
    for rx, label in POLICY_FORBIDDEN:
        m = rx.search(text)
        if m:
            line = text.count("\n", 0, m.start()) + 1
            raise HelperError("policy file contains forbidden construct %s (line %d)"
                              % (label, line))
    return text


def _unquote(v):
    if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        return v[1:-1], True
    return v, False


def _check_client_value(key, raw, lineno):
    v, quoted = _unquote(raw)
    if '"' in v or "\\" in v:
        raise HelperError("clients line %d: invalid characters in %s" % (lineno, key))
    if "${" in v or "$ENV" in v.upper():
        raise HelperError("clients line %d: variable expansion not allowed in %s" % (lineno, key))
    if key == "secret":
        if not quoted:
            raise HelperError("clients line %d: secret must be double-quoted" % lineno)
        if not re.match(r"^[\x21-\x7e]{16,128}$", v):
            raise HelperError("clients line %d: secret must be 16-128 printable ASCII "
                              "characters without whitespace" % lineno)
        return
    if key in ("ipaddr", "ipv4addr", "ipv6addr"):
        if not re.match(r"^[0-9A-Fa-f:.]+(/\d{1,3})?$", v):
            raise HelperError("clients line %d: invalid address" % lineno)
        try:
            net = ipaddress.ip_network(v, strict=False)
        except ValueError:
            raise HelperError("clients line %d: invalid address" % lineno)
        if key == "ipv4addr" and net.version != 4:
            raise HelperError("clients line %d: ipv4addr is not IPv4" % lineno)
        if key == "ipv6addr" and net.version != 6:
            raise HelperError("clients line %d: ipv6addr is not IPv6" % lineno)
        return
    if key == "shortname":
        if not re.match(r"^[A-Za-z0-9._-]{1,63}$", v):
            raise HelperError("clients line %d: invalid shortname" % lineno)
        return
    if key == "nas_type":
        if not re.match(r"^[A-Za-z0-9_-]{1,32}$", v):
            raise HelperError("clients line %d: invalid nas_type" % lineno)
        return
    if key == "radius_admin_profile":
        # vendor profile id (SPEC section 26), read by the policy as %{client:radius_admin_profile}
        if quoted or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", v):
            raise HelperError("clients line %d: invalid radius_admin_profile" % lineno)
        return
    if key in ("require_message_authenticator", "limit_proxy_state"):
        if v not in _YNA:
            raise HelperError("clients line %d: %s must be yes, no or auto" % (lineno, key))
        return
    raise HelperError("clients line %d: key %s not allowed" % (lineno, key))


_SECTION_OPEN = re.compile(r"^([a-z_]{1,32})(?:[ \t]+([A-Za-z0-9._-]{1,63}))?[ \t]*\{$")
_ADDR_KEYS = {"ipaddr", "ipv4addr", "ipv6addr"}
# RadSec (RFC 6614): one TLS listener plus one clients section, exactly as rendered by
# app/radius_admin/unlang.py. Every key and value is pinned; certificate paths may only
# name the site certificate files that mods-available/eap uses.
RADSEC_SECTION = "radius_admin_radsec"
_TLS_CLIENT_KEYS = {"ipaddr", "ipv4addr", "ipv6addr", "proto", "secret", "shortname", "nas_type",
                    "radsec_peer_name", "radius_admin_profile"}
_PEER_NAME = re.compile(r'^"[A-Za-z0-9*][A-Za-z0-9 ._*-]{0,252}"$|^""$')
_OCSP_URL = re.compile(r'^"https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,200})?"$')


def _parse_blocks(text):
    """Comments, blank lines, `name [arg] {` ... `}` sections and `key = value` pairs,
    one per line. Returns the top-level node {"pairs", "children"}."""
    root = {"name": None, "arg": None, "pairs": {}, "children": [], "line": 0}
    stack = [root]
    for lineno, line in enumerate(text.split("\n"), 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if s == "}":
            if len(stack) == 1:
                raise HelperError("clients line %d: unexpected }" % lineno)
            stack.pop()
            continue
        m = _SECTION_OPEN.match(s)
        if m:
            if len(stack) > 4:
                raise HelperError("clients line %d: sections nested too deeply" % lineno)
            node = {"name": m.group(1), "arg": m.group(2), "pairs": {}, "children": [], "line": lineno}
            stack[-1]["children"].append(node)
            stack.append(node)
            continue
        m = _PAIR.match(s)
        if not m or len(stack) == 1:
            raise HelperError("clients line %d: expected 'client <name> {' or a comment" % lineno)
        key, val = m.group(1), m.group(2).strip()
        if key in stack[-1]["pairs"]:
            raise HelperError("clients line %d: duplicate key %s" % (lineno, key))
        stack[-1]["pairs"][key] = (val, lineno)
    if len(stack) != 1:
        raise HelperError("clients file: section %s is not closed" % (stack[-1]["arg"] or stack[-1]["name"]))
    return root


def _int_value(node, key, lo, hi):
    val, lineno = node["pairs"][key]
    if not re.match(r"^[0-9]{1,6}$", val) or not lo <= int(val) <= hi:
        raise HelperError("clients line %d: %s must be a number from %d to %d" % (lineno, key, lo, hi))


def _only_keys(node, allowed, required=()):
    for key, (_, lineno) in node["pairs"].items():
        if key not in allowed:
            raise HelperError("clients line %d: key %s not allowed" % (lineno, key))
    for key in required:
        if key not in node["pairs"]:
            raise HelperError("clients line %d: %s needs %s" % (node["line"], node["name"], key))


def _fixed(node, key, *values):
    if key in node["pairs"]:
        val, lineno = node["pairs"][key]
        if val not in values:
            raise HelperError("clients line %d: %s must be %s" % (lineno, key, " or ".join(values)))


def _no_children(node, allowed=()):
    for c in node["children"]:
        if c["name"] not in allowed or c["arg"] is not None:
            raise HelperError("clients line %d: section %s not allowed here" % (c["line"], c["name"]))


def _one_address(node, what):
    if len(set(node["pairs"]) & _ADDR_KEYS) != 1:
        raise HelperError("%s: exactly one of ipaddr/ipv4addr/ipv6addr required" % what)


def _check_udp_client(node):
    name = node["arg"]
    _no_children(node)
    _only_keys(node, _CLIENT_KEYS)
    if "secret" not in node["pairs"]:
        raise HelperError("client %s: missing secret" % name)
    _one_address(node, "client %s" % name)
    for key, (val, lineno) in node["pairs"].items():
        _check_client_value(key, val, lineno)


def _check_tls_client(node):
    name = node["arg"]
    _no_children(node)
    _only_keys(node, _TLS_CLIENT_KEYS, ("proto", "secret"))
    _one_address(node, "RadSec client %s" % name)
    _fixed(node, "proto", "tls")
    _fixed(node, "secret", '"radsec"')
    for key, (val, lineno) in node["pairs"].items():
        if key == "radsec_peer_name":
            if not _PEER_NAME.match(val):
                raise HelperError("clients line %d: invalid radsec_peer_name" % lineno)
        elif key not in ("proto", "secret"):
            _check_client_value(key, val, lineno)


def _check_listen(node, cert_dir):
    _only_keys(node, {"type", "ipaddr", "ipv4addr", "ipv6addr", "port", "proto", "virtual_server",
                      "clients"}, ("type", "port", "proto", "virtual_server", "clients"))
    _one_address(node, "RadSec listen section")
    _fixed(node, "type", "auth+acct")
    _fixed(node, "proto", "tcp")
    _fixed(node, "virtual_server", "default")
    _fixed(node, "clients", RADSEC_SECTION)
    _int_value(node, "port", 1, 65535)
    for key in _ADDR_KEYS & set(node["pairs"]):
        val, lineno = node["pairs"][key]
        if not (key == "ipaddr" and val == "*"):
            _check_client_value(key, val, lineno)
            if "/" in val:
                raise HelperError("clients line %d: listen address must not be a network" % lineno)
    _no_children(node, ("limit", "tls"))
    names = [c["name"] for c in node["children"]]
    if names.count("tls") != 1 or names.count("limit") > 1:
        raise HelperError("RadSec listen section needs exactly one tls section")
    for c in node["children"]:
        if c["name"] == "limit":
            _no_children(c)
            _only_keys(c, {"max_connections", "lifetime", "idle_timeout"})
            for key in c["pairs"]:
                _int_value(c, key, 1 if key == "max_connections" else 0, 1024 if key == "max_connections" else 86400)
        else:
            _check_listen_tls(c, cert_dir)


def _check_listen_tls(node, cert_dir):
    _only_keys(node, {"private_key_file", "certificate_file", "ca_file", "require_client_cert",
                      "tls_min_version", "tls_max_version", "cipher_list", "ecdh_curve", "fragment_size"},
               ("private_key_file", "certificate_file", "ca_file", "require_client_cert"))
    _fixed(node, "private_key_file", os.path.join(cert_dir, "radius.key"))
    _fixed(node, "certificate_file", os.path.join(cert_dir, "radius.pem"))
    _fixed(node, "ca_file", os.path.join(cert_dir, "ca.pem"))
    _fixed(node, "require_client_cert", "yes")
    _fixed(node, "tls_min_version", '"1.2"', '"1.3"')
    _fixed(node, "tls_max_version", '"1.2"', '"1.3"')
    for key, rx in (("cipher_list", r'^"[A-Za-z0-9:+-]{1,512}"$'), ("ecdh_curve", r'^"[a-z0-9:]{1,64}"$')):
        if key in node["pairs"]:
            val, lineno = node["pairs"][key]
            if not re.match(rx, val):
                raise HelperError("clients line %d: invalid %s" % (lineno, key))
    if "fragment_size" in node["pairs"]:
        _int_value(node, "fragment_size", 1024, 16384)
    _no_children(node, ("ocsp",))
    if len(node["children"]) > 1:
        raise HelperError("RadSec tls section: at most one ocsp section")
    for c in node["children"]:
        _no_children(c)
        _only_keys(c, {"enable", "override_cert_url", "url", "use_nonce", "timeout", "softfail"}, ("enable",))
        for key in ("enable", "override_cert_url", "use_nonce", "softfail"):
            _fixed(c, key, "yes", "no")
        if "timeout" in c["pairs"]:
            _int_value(c, "timeout", 1, 60)
        if "url" in c["pairs"]:
            val, lineno = c["pairs"]["url"]
            if not _OCSP_URL.match(val):
                raise HelperError("clients line %d: invalid OCSP url" % lineno)


# Second-factor providers (SPEC section 29): per provider a home_server, home_server_pool and
# realm named radius_admin_mfa_<id>; with a Duo provider also the listener of the virtual
# server radius-admin-mfa-primary on 127.0.0.1 and its clients section with one client (the
# Duo proxy). Every key and value is pinned, exactly as rendered by app/radius_admin/unlang.py.
MFA_SECTION = "radius_admin_mfa"
MFA_SERVER = "radius-admin-mfa-primary"
MFA_NAME = re.compile(r"radius_admin_mfa_[a-z][a-z0-9-]{0,31}")
MFA_MAX_PROVIDERS = 8


def _is_mfa_listen(node):
    return node["pairs"].get("virtual_server", ("",))[0] == MFA_SERVER


def _check_mfa_listen(node):
    _no_children(node)
    _only_keys(node, {"type", "ipv4addr", "port", "proto", "virtual_server", "clients"},
               ("type", "ipv4addr", "port", "proto", "virtual_server", "clients"))
    _fixed(node, "type", "auth")
    _fixed(node, "ipv4addr", "127.0.0.1")
    _fixed(node, "proto", "udp")
    _fixed(node, "clients", MFA_SECTION)
    _int_value(node, "port", 1024, 65535)


def _check_mfa_clients(node):
    _only_keys(node, set())
    if len(node["children"]) != 1:
        raise HelperError("clients line %d: %s needs exactly one client" % (node["line"], MFA_SECTION))
    c = node["children"][0]
    if c["name"] != "client" or not c["arg"]:
        raise HelperError("clients line %d: only a client section is allowed in %s" % (c["line"], MFA_SECTION))
    _no_children(c)
    _only_keys(c, {"ipv4addr", "secret", "shortname", "require_message_authenticator"},
               ("ipv4addr", "secret", "require_message_authenticator"))
    _fixed(c, "ipv4addr", "127.0.0.1")
    _fixed(c, "require_message_authenticator", "yes")
    for key, (val, lineno) in c["pairs"].items():
        _check_client_value(key, val, lineno)


def _mfa_name(node):
    if not node["arg"] or not MFA_NAME.fullmatch(node["arg"]):
        raise HelperError("clients line %d: %s must be named radius_admin_mfa_<id>" % (node["line"], node["name"]))
    return node["arg"]


def _check_home_server(node):
    _no_children(node)
    _only_keys(node, {"type", "ipv4addr", "ipv6addr", "port", "proto", "secret", "require_message_authenticator",
                      "response_window", "zombie_period", "revive_interval", "status_check"},
               ("type", "port", "proto", "secret", "require_message_authenticator", "response_window",
                "status_check"))
    if len(set(node["pairs"]) & {"ipv4addr", "ipv6addr"}) != 1:
        raise HelperError("home_server %s: exactly one of ipv4addr/ipv6addr required" % node["arg"])
    _fixed(node, "type", "auth")
    _fixed(node, "proto", "udp")
    _fixed(node, "require_message_authenticator", "yes", "no")
    _fixed(node, "status_check", "none")
    _int_value(node, "port", 1, 65535)
    _int_value(node, "response_window", 1, 60)
    for key, lo, hi in (("zombie_period", 1, 120), ("revive_interval", 10, 3600)):
        if key in node["pairs"]:
            _int_value(node, key, lo, hi)
    for key in ("ipv4addr", "ipv6addr", "secret"):
        if key in node["pairs"]:
            val, lineno = node["pairs"][key]
            _check_client_value(key, val, lineno)
            if key != "secret" and "/" in val:
                raise HelperError("clients line %d: a home server address must not be a network" % lineno)


def _check_mfa_ref(node, kind, key, known):
    _no_children(node)
    _only_keys(node, {key} | ({"type"} if kind == "home_server_pool" else set()), (key,))
    if kind == "home_server_pool":
        _fixed(node, "type", "fail-over")
    val, lineno = node["pairs"][key]
    if val != node["arg"] or val not in known:
        raise HelperError("clients line %d: %s %s must name its own %s" % (lineno, kind, node["arg"], key))


# The Duo Authentication Proxy's authproxy.cfg (SPEC section 29.2), exactly as rendered by
# app/radius_admin/unlang.py: three sections, every key known, every value pinned or patterned.
_DUO_SECRET = r"[A-Za-z0-9]{16,128}"
_DUO_KEYS = {
    "main": {"log_auth_events": r"true|false", "fips_mode": r"true"},
    "radius_client": {"host": r"127\.0\.0\.1", "port": r"[0-9]{4,5}", "secret": _DUO_SECRET,
                      "pass_through_attr_names": r"Class"},
    "radius_server_auto": {"ikey": r"DI[A-Z0-9]{18}", "skey": r"[A-Za-z0-9]{40}",
                           "api_host": r"api-[a-z0-9]{1,16}\.duosecurity\.com", "radius_ip_1": r"127\.0\.0\.1",
                           "radius_secret_1": _DUO_SECRET, "interface": r"127\.0\.0\.1", "port": r"[0-9]{4,5}",
                           "client": r"radius_client", "failmode": r"secure|safe",
                           "factors": r"(auto|push|phone|passcode)(,(auto|push|phone|passcode)){0,3}",
                           "pass_through_attr_names": r"Message-Authenticator",
                           "force_message_authenticator": r"true"},
}
_DUO_REQUIRED = {"main": set(), "radius_client": {"host", "port", "secret", "pass_through_attr_names"},
                 "radius_server_auto": {"ikey", "skey", "api_host", "radius_ip_1", "radius_secret_1", "interface",
                                        "port", "client", "failmode", "pass_through_attr_names",
                                        "force_message_authenticator"}}


def check_duo_config(data, fips):
    """Whitelist grammar for authproxy.cfg; in FIPS mode fips_mode=true and failmode=secure."""
    text = check_text(data, "Duo configuration")
    lines = text.split("\n")
    if not lines[0].startswith("; radius-admin"):
        raise HelperError("Duo configuration: the first line must be the radius-admin header")
    found, cur = {}, None
    for lineno, line in enumerate(lines, 1):
        s = line.strip()
        if not s or s.startswith(";") or s.startswith("#"):
            continue
        m = re.fullmatch(r"\[([a-z_]{1,32})\]", s)
        if m:
            cur = m.group(1)
            if cur not in _DUO_KEYS:
                raise HelperError("Duo configuration line %d: section [%s] not allowed" % (lineno, cur))
            if cur in found:
                raise HelperError("Duo configuration line %d: duplicate section [%s]" % (lineno, cur))
            found[cur] = {}
            continue
        m = re.fullmatch(r"([a-z_0-9]{1,40})=(.*)", s)
        if not m or cur is None:
            raise HelperError("Duo configuration line %d: expected [section] or key=value" % lineno)
        key, val = m.group(1), m.group(2)
        rx = _DUO_KEYS[cur].get(key)
        if rx is None:
            raise HelperError("Duo configuration line %d: key %s not allowed in [%s]" % (lineno, key, cur))
        if key in found[cur]:
            raise HelperError("Duo configuration line %d: duplicate key %s" % (lineno, key))
        if not re.fullmatch(rx, val) or (key == "port" and not 1024 <= int(val) <= 65535):
            raise HelperError("Duo configuration line %d: invalid value for %s" % (lineno, key))
        found[cur][key] = val
    for sec, req in _DUO_REQUIRED.items():
        if sec != "main" and sec not in found:
            raise HelperError("Duo configuration: section [%s] missing" % sec)
        missing = req - set(found.get(sec, {}))
        if missing:
            raise HelperError("Duo configuration: [%s] needs %s" % (sec, ", ".join(sorted(missing))))
    if fips and (found.get("main", {}).get("fips_mode") != "true"
                 or found["radius_server_auto"]["failmode"] != "secure"):
        raise HelperError("Duo configuration: FIPS mode needs fips_mode=true and failmode=secure")
    return found


def check_clients(data, cert_dir="/etc/freeradius/certs/site"):
    """Whitelist grammar: comments, blank lines, `client NAME {` ... `}` blocks with
    whitelisted `key = value` pairs, one per line; optionally one RadSec `listen {}`
    section with one `clients radius_admin_radsec {}` section (both or neither); optionally
    the second-factor sections (SPEC section 29): per provider `home_server`,
    `home_server_pool` and `realm radius_admin_mfa_<id>` (in that order), and one MFA
    `listen {}` with one `clients radius_admin_mfa {}` (both or neither).
    Returns the number of RADIUS clients (the Duo proxy's loopback client not counted)."""
    root = _parse_blocks(check_text(data, "clients"))
    names = set()
    count = 0
    listens = [c for c in root["children"] if c["name"] == "listen" and not _is_mfa_listen(c)]
    sections = [c for c in root["children"] if c["name"] == "clients" and c["arg"] == RADSEC_SECTION]
    mfa_listens = [c for c in root["children"] if c["name"] == "listen" and _is_mfa_listen(c)]
    mfa_sections = [c for c in root["children"] if c["name"] == "clients" and c["arg"] == MFA_SECTION]
    homes, pools, realms = set(), set(), set()
    for c in root["children"]:
        if c["name"] == "client" and c["arg"]:
            clients = [c]
            _check_udp_client(c)
        elif c["name"] == "clients" and c["arg"] == RADSEC_SECTION and len(sections) == 1:
            _only_keys(c, set())
            for x in c["children"]:
                if x["name"] != "client" or not x["arg"]:
                    raise HelperError("clients line %d: only client sections allowed in %s"
                                      % (x["line"], RADSEC_SECTION))
            clients = c["children"]
            if not clients:
                raise HelperError("RadSec clients section is empty")
            for tc in clients:
                _check_tls_client(tc)
        elif c["name"] == "listen" and c["arg"] is None and not _is_mfa_listen(c) and len(listens) == 1:
            _check_listen(c, cert_dir)
            continue
        elif c["name"] == "listen" and c["arg"] is None and _is_mfa_listen(c) and len(mfa_listens) == 1:
            _check_mfa_listen(c)
            continue
        elif c["name"] == "clients" and c["arg"] == MFA_SECTION and len(mfa_sections) == 1:
            _check_mfa_clients(c)
            continue
        elif c["name"] == "home_server":
            name = _mfa_name(c)
            if name in homes:
                raise HelperError("clients line %d: duplicate home_server %s" % (c["line"], name))
            _check_home_server(c)
            homes.add(name)
            if len(homes) > MFA_MAX_PROVIDERS:
                raise HelperError("clients line %d: at most %d second-factor providers" % (c["line"], MFA_MAX_PROVIDERS))
            continue
        elif c["name"] == "home_server_pool":
            name = _mfa_name(c)
            if name in pools:
                raise HelperError("clients line %d: duplicate home_server_pool %s" % (c["line"], name))
            _check_mfa_ref(c, "home_server_pool", "home_server", homes)
            pools.add(name)
            continue
        elif c["name"] == "realm":
            name = _mfa_name(c)
            if name in realms:
                raise HelperError("clients line %d: duplicate realm %s" % (c["line"], name))
            _check_mfa_ref(c, "realm", "auth_pool", pools)
            realms.add(name)
            continue
        else:
            raise HelperError("clients line %d: expected 'client <name> {' or a comment" % c["line"])
        for cl in clients:
            if cl["arg"] in names:
                raise HelperError("clients line %d: duplicate client %s" % (cl["line"], cl["arg"]))
            names.add(cl["arg"])
            count += 1
    if len(listens) != len(sections):
        raise HelperError("RadSec needs both its listen section and its clients section")
    if len(mfa_listens) != len(mfa_sections):
        raise HelperError("the second-factor listener needs both its listen section and its clients section")
    if not homes == pools == realms:
        raise HelperError("every second-factor home_server needs its home_server_pool and realm")
    return count


# --------------------------------------------------------------------------- staging

STAGED_PROVIDERS = {"duo": "provider-duo"}     # SPEC section 29.2


def _staging_dirfd(cfg):
    try:
        dfd = os.open(cfg["staging_dir"], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                      | os.O_CLOEXEC)
    except OSError as e:
        raise HelperError("staging directory unavailable: %s" % e.strerror)
    st = os.fstat(dfd)
    if st.st_uid not in (0, cfg["staging_uid"]) or st.st_mode & 0o022:
        os.close(dfd)
        raise HelperError("staging directory has unsafe ownership or permissions")
    return dfd


def _read_staged_file(cfg, dfd, name, optional=False):
    """One staged file, opened without following symlinks: a regular, single-linked file of
    the staging owner, <= 1 MiB. None when optional and absent."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
                     | getattr(os, "O_NOCTTY", 0), dir_fd=dfd)
    except FileNotFoundError:
        if optional:
            return None
        raise HelperError("staged %s missing: %s" % (name, os.strerror(errno.ENOENT)))
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise HelperError("staged %s is a symlink" % name)
        raise HelperError("staged %s missing: %s" % (name, e.strerror))
    try:
        fst = os.fstat(fd)
        if not stat.S_ISREG(fst.st_mode):
            raise HelperError("staged %s is not a regular file" % name)
        if fst.st_uid != cfg["staging_uid"]:
            raise HelperError("staged %s is not owned by %s" % (name, cfg["staging_owner"]))
        if fst.st_nlink != 1:
            raise HelperError("staged %s has multiple hard links" % name)
        if fst.st_size > MAX_STAGED:
            raise HelperError("staged %s exceeds 1 MiB" % name)
        chunks = []
        remaining = MAX_STAGED + 1
        while remaining > 0:
            b = os.read(fd, min(65536, remaining))
            if not b:
                break
            chunks.append(b)
            remaining -= len(b)
        data = b"".join(chunks)
        if len(data) > MAX_STAGED:
            raise HelperError("staged %s exceeds 1 MiB" % name)
        return data
    finally:
        os.close(fd)


def read_staged(cfg):
    """Read both staged files without following symlinks. Returns (policy, clients) bytes."""
    dfd = _staging_dirfd(cfg)
    try:
        return (_read_staged_file(cfg, dfd, STAGED_POLICY), _read_staged_file(cfg, dfd, STAGED_CLIENTS))
    finally:
        os.close(dfd)


def read_staged_duo(cfg):
    """The staged Duo Authentication Proxy configuration (provider-duo), or None."""
    dfd = _staging_dirfd(cfg)
    try:
        return _read_staged_file(cfg, dfd, STAGED_PROVIDERS["duo"], optional=True)
    finally:
        os.close(dfd)


def read_root_file(path):
    """Read a file from the helper's own (root-only) area or the live raddb; None if absent."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise HelperError("cannot read %s: %s" % (path, e.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise HelperError("%s is not a regular file" % path)
        if st.st_size > MAX_STAGED:
            raise HelperError("%s exceeds 1 MiB" % path)
        with os.fdopen(fd, "rb", closefd=False) as fh:
            return fh.read(MAX_STAGED + 1)
    finally:
        os.close(fd)


# --------------------------------------------------------------------------- filesystem helpers

def sha256(b):
    return hashlib.sha256(b).hexdigest()


def fsync_dir(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def atomic_write(path, data, uid, gid, mode):
    """Write data to path atomically (temp file in same dir + rename). The temp name
    starts with '.' so FreeRADIUS' `$INCLUDE policy.d/` never picks it up."""
    d = os.path.dirname(path)
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode):
        raise HelperError("%s is not a directory" % d)
    if os.path.islink(path):
        raise HelperError("refusing to replace symlink %s" % path)
    fd, tmp = tempfile.mkstemp(prefix=".radius-admin.", dir=d)
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            n = os.write(fd, view)
            view = view[n:]
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp, path)
        tmp = None
        fsync_dir(d)
    finally:
        if fd >= 0:
            os.close(fd)
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def remove_file(path):
    try:
        os.unlink(path)
        fsync_dir(os.path.dirname(path))
    except FileNotFoundError:
        pass


def ensure_work_dirs(cfg):
    w = cfg["work_dir"]
    os.makedirs(w, mode=0o711, exist_ok=True)
    st = os.lstat(w)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
        raise HelperError("work_dir must be a root-owned directory")
    os.chmod(w, 0o711)  # traverse-only for freerad (needed to reach validate/)
    b = os.path.join(w, "backups")
    os.makedirs(b, mode=0o700, exist_ok=True)
    os.chmod(b, 0o700)
    v = os.path.join(w, "validate")
    os.makedirs(v, mode=0o750, exist_ok=True)
    os.chown(v, 0, cfg["freerad_gid"])
    os.chmod(v, 0o750)
    return b, v


class Lock:
    def __init__(self, cfg, name="lock", what="another apply/validate"):
        self.path = os.path.join(cfg["work_dir"], name)
        self.timeout = cfg["lock_timeout"]
        self.what = what
        self.fd = None

    def __enter__(self):
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        deadline = time.monotonic() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    raise HelperError("%s is in progress; try again later" % self.what)
                time.sleep(0.2)

    def __exit__(self, *exc):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


# --------------------------------------------------------------------------- validation

def _plain_mode(st):
    """Permission bits without setuid/setgid. The helper unit runs with
    RestrictSUIDSGID=yes, so chmod() with S_ISUID/S_ISGID fails with EPERM -- and the
    live /etc/freeradius tree typically has setgid directories (drwxr-s--x). The bits
    are irrelevant for a throw-away validation copy, so they are dropped."""
    return stat.S_IMODE(st.st_mode) & ~(stat.S_ISUID | stat.S_ISGID)


def _copy_tree(src_root, dst_root):
    """Copy src_root to dst_root (must not exist): regular files, directories and
    symlinks only, ownership preserved, setuid/setgid bits dropped. Special files are
    skipped. Directory modes are applied last, deepest first."""
    os.mkdir(dst_root, 0o700)
    dirs = [(src_root, dst_root)]
    for dirpath, dirnames, filenames in os.walk(src_root):
        rel = os.path.relpath(dirpath, src_root)
        ddir = dst_root if rel == "." else os.path.join(dst_root, rel)
        keep = []
        for name in sorted(dirnames) + sorted(filenames):
            s = os.path.join(dirpath, name)
            t = os.path.join(ddir, name)
            try:
                st = os.lstat(s)
            except OSError:
                continue
            if stat.S_ISLNK(st.st_mode):
                os.symlink(os.readlink(s), t)
                os.lchown(t, st.st_uid, st.st_gid)
            elif stat.S_ISDIR(st.st_mode):
                os.mkdir(t, 0o700)
                dirs.append((s, t))
                keep.append(name)
            elif stat.S_ISREG(st.st_mode):
                shutil.copyfile(s, t, follow_symlinks=False)
                os.chown(t, st.st_uid, st.st_gid)
                os.chmod(t, _plain_mode(st))
            # FIFOs, sockets, devices: skipped
        dirnames[:] = [d for d in dirnames if d in keep]
    for s, t in reversed(dirs):
        st = os.lstat(s)
        os.chown(t, st.st_uid, st.st_gid)
        os.chmod(t, _plain_mode(st))


def build_validation_tree(cfg, vroot, policy, clients, cert_files=None):
    """Copy raddb into a private dir (root:freerad 0750) with the candidate files
    overlaid at their live positions, and point raddbdir at the copy."""
    tmp = tempfile.mkdtemp(prefix="raddb.", dir=vroot)
    os.chown(tmp, 0, cfg["freerad_gid"])
    os.chmod(tmp, 0o750)
    rd = os.path.join(tmp, "raddb")

    _copy_tree(cfg["raddb"], rd)
    # absolute symlinks that point into the live raddb (e.g. mods-enabled/sql ->
    # /etc/freeradius/mods-available/sql) are repointed into the copy
    live = cfg["raddb"].rstrip("/") + "/"
    for dirpath, dirnames, filenames in os.walk(rd):
        for name in dirnames + filenames:
            p = os.path.join(dirpath, name)
            if os.path.islink(p):
                t = os.readlink(p)
                if t.startswith(live):
                    os.unlink(p)
                    os.symlink(os.path.join(rd, t[len(live):]), p)
    # radiusd refuses world-writable config dirs; the copy root must be traversable by freerad
    os.chown(rd, 0, cfg["freerad_gid"])
    os.chmod(rd, 0o750)
    pd = os.path.join(rd, "policy.d")
    if not os.path.isdir(pd) or os.path.islink(pd):
        raise HelperError("raddb has no policy.d directory")
    for path, data in ((os.path.join(pd, POLICY_NAME), policy),
                       (os.path.join(rd, CLIENTS_NAME), clients)):
        if os.path.lexists(path):
            os.unlink(path)
        atomic_write(path, data, 0, cfg["freerad_gid"], 0o640)
    # radiusd.conf normally pins `raddbdir = /etc/freeradius`; repoint it at the copy so
    # ${confdir}/... references resolve inside the candidate tree.
    main = os.path.join(rd, cfg["config_name"] + ".conf")
    if os.path.islink(main):
        real = os.path.realpath(main)
        os.unlink(main)
        shutil.copyfile(real, main)
    if os.path.isfile(main):
        with open(main, "r", encoding="utf-8", errors="surrogateescape") as fh:
            txt = fh.read()
        txt, n = re.subn(r"(?m)^([ \t]*raddbdir[ \t]*=).*$", lambda m: m.group(1) + " " + rd, txt)
        st = os.lstat(os.path.join(cfg["raddb"], cfg["config_name"] + ".conf"))
        atomic_write(main, txt.encode("utf-8", "surrogateescape"), st.st_uid, st.st_gid,
                     _plain_mode(st))
    # the copy reads its own certs/site (candidate certificate files, if any, in place)
    overlay_certs(rd, cfg, {k: v for k, v in (cert_files or {}).items() if k in FR_CERT_FILES})
    return tmp, rd


def run_check(cfg, rd):
    # Run as root, exactly as the service does: radiusd parses its configuration as
    # root (some live files, e.g. switches.conf or clients.conf, may be root-only) and
    # switches to "user = freerad" itself before any module is instantiated. Staged
    # content has already passed check_policy/check_clients ($INCLUDE, $ENV, exec and
    # raw attribute forms refused), so parsing it as root adds nothing that a normal
    # service restart would not do anyway.
    argv = [cfg["radiusd"], "-XC", "-d", rd, "-n", cfg["config_name"]]
    return run(argv, cfg["validate_timeout"])


def validate_candidate(cfg, vroot, policy, clients, cert_files=None):
    """Content checks + radiusd -XC on a private copy. Returns (ok, output_tail, n_clients)."""
    check_policy(policy)
    n = check_clients(clients, os.path.join(cfg["raddb"], "certs", "site"))
    tmp = None
    try:
        tmp, rd = build_validation_tree(cfg, vroot, policy, clients, cert_files)
        rc, out = run_check(cfg, rd)
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    ok = rc == 0 and ("Configuration appears to be OK" in out or "appears to be OK" in out)
    return ok, tail(out), n


# --------------------------------------------------------------------------- service control

def service_active(cfg):
    rc, out = run([cfg["systemctl"], "is-active", "--quiet", cfg["service"]], 15)
    return rc == 0


def udp_listening(cfg):
    rc, out = run([cfg["ss"], "-H", "-lunp"], 10)
    if rc != 0:
        return False
    port = ":%d" % cfg["radius_port"]
    prog = os.path.basename(cfg["radiusd"])
    for line in out.splitlines():
        cols = line.split()
        # State Recv-Q Send-Q Local:Port Peer:Port [Process]   (-H: no header)
        if len(cols) < 5 or not cols[3].endswith(port):
            continue
        procs = " ".join(cols[5:])
        # with -p, ss names the owning process; require it to be radiusd when shown
        if not procs or ('"%s"' % prog) in procs:
            return True
    return False


def portal_status(cfg):
    """The web portal: nginx active and listening on TCP portal_port (when its site is enabled)."""
    if not os.path.lexists(cfg["portal_site"]):
        return {"portal_configured": False, "portal_active": False, "portal_listening": False}
    rc, out = run([cfg["systemctl"], "is-active", "--quiet", cfg["portal_service"]], 15)
    active = rc == 0
    listening = False
    if active:
        rc, out = run([cfg["ss"], "-H", "-ltnp"], 10)
        port = ":%d" % cfg["portal_port"]
        for line in (out.splitlines() if rc == 0 else []):
            cols = line.split()
            # State Recv-Q Send-Q Local:Port Peer:Port [Process]; nginx when ss names the process
            if len(cols) >= 5 and cols[3].endswith(port):
                procs = " ".join(cols[5:])
                if not procs or '"nginx"' in procs:
                    listening = True
                    break
    return {"portal_configured": True, "portal_active": active, "portal_listening": listening}


def restart_and_wait(cfg):
    rc, out = run([cfg["systemctl"], "restart", cfg["service"]], cfg["restart_timeout"])
    deadline = time.monotonic() + cfg["restart_wait"]
    active = listening = False
    while True:
        active = service_active(cfg)
        listening = active and udp_listening(cfg)
        if active and listening:
            return True, "service %s active and listening on UDP %d" % (
                cfg["service"], cfg["radius_port"])
        if time.monotonic() >= deadline:
            break
        time.sleep(0.5)
    why = []
    if rc != 0:
        why.append("systemctl restart exited %d: %s" % (rc, tail(out, 5)))
    if not active:
        why.append("service not active")
    elif not listening:
        why.append("UDP %d not listening" % cfg["radius_port"])
    return False, "; ".join(why)


# --------------------------------------------------------------------------- backups / state

def utc_id():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def list_backups(bdir):
    try:
        names = [n for n in os.listdir(bdir) if BACKUP_ID_RE.match(n)
                 and os.path.isdir(os.path.join(bdir, n))
                 and not os.path.islink(os.path.join(bdir, n))]
    except FileNotFoundError:
        return []
    return sorted(names, reverse=True)


def duo_cfg_path(cfg):
    return os.path.join(cfg["duo_dir"], "conf", "authproxy.cfg")


def make_backup(cfg, bdir, reason, duo_managed=False, cert_names=()):
    for _ in range(3):
        bid = utc_id()
        path = os.path.join(bdir, bid)
        try:
            os.mkdir(path, 0o700)
            break
        except FileExistsError:
            time.sleep(1.05)
    else:
        raise HelperError("could not allocate a backup id")
    meta = {"id": bid, "reason": reason, "files": {}, "duo_managed": bool(duo_managed),
            "certs": sorted(cert_names)}
    sources = [(cfg["policy_target"], "policy"), (cfg["clients_target"], "clients")]
    if duo_managed:     # this apply changes the Duo Authentication Proxy's configuration too
        sources.append((duo_cfg_path(cfg), "duo"))
    for name in sorted(cert_names):     # the certificate files this apply replaces (SPEC 30)
        sources.append((cert_target(cfg, name)[0], name))
    for src, name in sources:
        data = read_root_file(src)
        if data is None:
            meta["files"][name] = None
        else:
            atomic_write(os.path.join(path, name), data, 0, 0, 0o600)
            meta["files"][name] = sha256(data)
    atomic_write(os.path.join(path, "meta.json"),
                 json.dumps(meta, sort_keys=True).encode(), 0, 0, 0o600)
    return bid


def load_backup(bdir, bid):
    if not isinstance(bid, str) or not BACKUP_ID_RE.match(bid):
        raise HelperError("invalid backup_id")
    path = os.path.join(bdir, bid)
    st = None
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        pass
    if st is None or not stat.S_ISDIR(st.st_mode):
        raise HelperError("backup %s not found" % bid)
    raw = read_root_file(os.path.join(path, "meta.json"))
    if raw is None:
        raise HelperError("backup %s is incomplete" % bid)
    meta = json.loads(raw.decode())
    files = {"duo_managed": meta.get("duo_managed") is True}
    certs = [n for n in meta.get("certs") or [] if n in CERT_FILES]
    files["certs"] = {}
    for name in ("policy", "clients") + (("duo",) if files["duo_managed"] else ()) + tuple(certs):
        if meta["files"].get(name) is None:
            files[name] = None
            continue
        data = read_root_file(os.path.join(path, name))
        if data is None or sha256(data) != meta["files"][name]:
            raise HelperError("backup %s is corrupt (%s)" % (bid, name))
        files[name] = data
    for name in certs:
        files["certs"][name] = files.pop(name, None)
    return files


def install_files(cfg, policy, clients):
    for key, data in (("policy_target", policy), ("clients_target", clients)):
        if data is None:
            remove_file(cfg[key])
        else:
            atomic_write(cfg[key], data, 0, cfg["freerad_gid"], 0o640)


def prune_backups(cfg, bdir, protect=()):
    names = list_backups(bdir)
    for n in names[cfg["keep_backups"]:]:
        if n in protect:
            continue
        shutil.rmtree(os.path.join(bdir, n), ignore_errors=True)


def read_state(cfg):
    raw = read_root_file(os.path.join(cfg["work_dir"], "state.json"))
    if not raw:
        return {}
    try:
        return json.loads(raw.decode())
    except ValueError:
        return {}


def write_state(cfg, state):
    atomic_write(os.path.join(cfg["work_dir"], "state.json"),
                 json.dumps(state, sort_keys=True).encode(), 0, 0, 0o600)


# --------------------------------------------------------------------------- certificates (SPEC section 30)

STAGED_CERTS = "certificates"
CERT_SECTIONS = ("format", "eap_server", "client_ca", "eap_ocsp", "portal_server")
OCSP_URL_RE = re.compile(r"\Ahttps?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,200})?\Z")
PEM_CERT_RE = re.compile(r"-----BEGIN CERTIFICATE-----\n[A-Za-z0-9+/=\n]{1,20000}?\n-----END CERTIFICATE-----")
PEM_KEY_RE = re.compile(r"\A-----BEGIN (EC |RSA |)PRIVATE KEY-----\n[A-Za-z0-9+/=\n]{1,20000}?\n-----END \1PRIVATE KEY-----\n?\Z")
# The files a certificate change can touch, by name (backups and responses use these names)
CERT_FILES = ("eap_cert", "eap_key", "eap_ca", "eap_conf", "portal_cert", "portal_key", "portal_ca")
FR_CERT_FILES = ("eap_cert", "eap_key", "eap_ca", "eap_conf")
PORTAL_CERT_FILES = ("portal_cert", "portal_key", "portal_ca")
MAX_CERT_PEM = 64 * 1024


def cert_target(cfg, name):
    """(path, uid, gid, mode, relative path in raddb or None) of a certificate file."""
    site = os.path.join(cfg["raddb"], "certs", "site")
    g, tls = cfg["freerad_gid"], cfg["portal_tls_dir"]
    return {"eap_cert": (os.path.join(site, "radius.pem"), 0, g, 0o640, "certs/site/radius.pem"),
            "eap_key": (os.path.join(site, "radius.key"), 0, g, 0o640, "certs/site/radius.key"),
            "eap_ca": (os.path.join(site, "ca.pem"), 0, g, 0o640, "certs/site/ca.pem"),
            "eap_conf": (os.path.join(cfg["raddb"], "mods-available", "eap"), 0, g, 0o640,
                         "mods-available/eap"),
            "portal_cert": (os.path.join(tls, "server.crt"), 0, 0, 0o644, None),
            "portal_key": (os.path.join(tls, "server.key"), 0, 0, 0o600, None),
            "portal_ca": (os.path.join(tls, "client-ca.pem"), 0, 0, 0o644, None)}[name]


def read_staged_certs(cfg):
    """The staged certificates file (JSON), or None."""
    dfd = _staging_dirfd(cfg)
    try:
        return _read_staged_file(cfg, dfd, STAGED_CERTS, optional=True)
    finally:
        os.close(dfd)


def _ossl(cfg, args, data):
    rc, out = run([cfg["openssl"]] + args, 20, input_data=data.encode() if isinstance(data, str) else data)
    return rc, out


def _cert_blocks(text, what):
    if not isinstance(text, str) or not text.strip() or len(text) > MAX_CERT_PEM:
        raise HelperError("%s: expected PEM text" % what)
    text = text.replace("\r\n", "\n").strip() + "\n"
    blocks = PEM_CERT_RE.findall(text)
    rest = PEM_CERT_RE.sub("", text)
    if not blocks or rest.strip():
        raise HelperError("%s: only PEM certificates (BEGIN CERTIFICATE) are allowed" % what)
    return blocks


def _cert_info(cfg, pem):
    """Facts about one PEM certificate from openssl x509 -text."""
    rc, out = _ossl(cfg, ["x509", "-noout", "-text", "-nameopt", "RFC2253", "-fingerprint", "-sha256"], pem)
    if rc != 0:
        raise HelperError("not a valid certificate: %s" % tail(out, 2))
    info = {"text": out}
    for key, rx in (("subject", r"^\s*Subject: (.*)$"), ("issuer", r"^\s*Issuer: (.*)$"),
                    ("not_before", r"Not Before\s*: (.*)$"), ("not_after", r"Not After\s*: (.*)$"),
                    ("sig", r"^\s*Signature Algorithm: (\S+)"),
                    ("sha256", r"(?i)sha256 Fingerprint=([0-9A-F:]+)")):
        m = re.search(rx, out, re.M)
        info[key] = m.group(1).strip() if m else ""
    m = re.search(r"X509v3 Subject Alternative Name:[^\n]*\n\s*([^\n]*)", out)
    info["san"] = [s.strip() for s in m.group(1).split(",")] if m else []
    m = re.search(r"X509v3 Extended Key Usage:[^\n]*\n\s*([^\n]*)", out)
    info["eku"] = [s.strip() for s in m.group(1).split(",")] if m else []
    m = re.search(r"X509v3 Basic Constraints:[^\n]*\n\s*([^\n]*)", out)
    info["ca"] = bool(m and "CA:TRUE" in m.group(1))
    if re.search(r"Public Key Algorithm: rsaEncryption", out):
        m = re.search(r"Public-Key: \((\d+) bit\)", out)
        info["key"] = "RSA %s" % (m.group(1) if m else "?")
    elif re.search(r"Public Key Algorithm: id-ecPublicKey", out):
        m = re.search(r"NIST CURVE: (P-\d+)", out) or re.search(r"ASN1 OID: (\S+)", out)
        info["key"] = "ECDSA %s" % (m.group(1) if m else "?")
    else:
        m = re.search(r"Public Key Algorithm: (\S+)", out)
        info["key"] = m.group(1) if m else "unknown"
    rc, _ = _ossl(cfg, ["x509", "-noout", "-checkend", "0"], pem)
    info["expired"] = rc != 0
    return info


def _key_allowed(desc):
    """FIPS-safe key types (SPEC section 7): RSA >= 3072, ECDSA P-256 / P-384."""
    m = re.match(r"RSA (\d+)\Z", desc)
    if m:
        return int(m.group(1)) >= 3072
    return desc in ("ECDSA P-256", "ECDSA P-384", "ECDSA prime256v1", "ECDSA secp384r1")


def _check_server(cfg, section, what, server_name=None):
    if not isinstance(section, dict) or set(section) != {"cert", "key"}:
        raise HelperError("%s: expected {cert, key}" % what)
    blocks = _cert_blocks(section["cert"], what + " certificate")
    key = section["key"]
    if not isinstance(key, str) or len(key) > MAX_CERT_PEM:
        raise HelperError("%s: expected a PEM private key" % what)
    key = key.replace("\r\n", "\n").strip() + "\n"
    if not PEM_KEY_RE.match(key):
        raise HelperError("%s: the key must be one unencrypted PEM private key" % what)
    leaf = _cert_info(cfg, blocks[0])
    if leaf["expired"]:
        raise HelperError("%s: the certificate has expired (%s)" % (what, leaf["not_after"]))
    if not _key_allowed(leaf["key"]):
        raise HelperError("%s: key type %s is not allowed (use RSA 3072 or larger, or ECDSA P-256/P-384)"
                          % (what, leaf["key"]))
    if not re.search(r"(?i)sha(256|384|512)", leaf["sig"]):
        raise HelperError("%s: signature algorithm %s is not allowed (SHA-256, SHA-384 or SHA-512 only)"
                          % (what, leaf["sig"]))
    if leaf["ca"]:
        raise HelperError("%s: the first certificate is a CA certificate, not a server certificate" % what)
    if leaf["eku"] and "TLS Web Server Authentication" not in leaf["eku"]:
        raise HelperError("%s: the certificate is not for server authentication (extended key usage)" % what)
    rc1, pub_c = _ossl(cfg, ["x509", "-noout", "-pubkey"], blocks[0])
    rc2, pub_k = _ossl(cfg, ["pkey", "-pubout"], key)
    if rc1 != 0 or rc2 != 0 or pub_c.strip() != pub_k.strip():
        raise HelperError("%s: the private key does not belong to the certificate" % what)
    if server_name is not None and "DNS:%s" % server_name not in leaf["san"]:
        raise HelperError("%s: the certificate does not name %s (subject alternative name)" % (what, server_name))
    for b in blocks[1:]:
        _cert_info(cfg, b)
    return "\n".join(blocks) + "\n", key


def _check_ca_bundle(cfg, text, what):
    blocks = _cert_blocks(text, what)
    for b in blocks:
        info = _cert_info(cfg, b)
        if not info["ca"]:
            raise HelperError("%s: %s is not a CA certificate" % (what, info["subject"] or "a certificate"))
        if info["expired"]:
            raise HelperError("%s: %s has expired" % (what, info["subject"]))
    return "\n".join(blocks) + "\n"


def portal_server_name(cfg):
    """server_name of the installed portal site, or None."""
    try:
        path = os.path.realpath(cfg["portal_site"])
        raw = read_root_file(path)
    except HelperError:
        return None
    m = re.search(rb"(?m)^\s*server_name\s+([A-Za-z0-9.-]+)\s*;", raw or b"")
    return m.group(1).decode() if m else None


def portal_listen(cfg):
    try:
        raw = read_root_file(os.path.realpath(cfg["portal_site"])) or b""
    except HelperError:
        return None
    m = re.search(rb"(?m)^\s*listen\s+([0-9.]+|\[[0-9a-fA-F:]+\]):%d\b" % cfg["portal_port"], raw)
    return m.group(1).decode() if m else None


def set_eap_ocsp(text, enable, url):
    """mods-available/eap with ocsp { enable, url } of tls-config tls-common set."""
    m = re.search(r"(?m)^([ \t]*)tls-config[ \t]+tls-common[ \t]*\{", text)
    if not m:
        raise HelperError("mods-available/eap has no tls-config tls-common section")
    o = re.compile(r"(?m)^([ \t]*)ocsp[ \t]*\{[^\n]*\n(.*?)^\1\}", re.S).search(text, m.end())
    if not o:
        raise HelperError("mods-available/eap has no ocsp { } section")
    body = o.group(2)
    body, n = re.subn(r"(?m)^([ \t]*)enable[ \t]*=.*$", lambda x: x.group(1) + "enable = " + ("yes" if enable else "no"),
                      body, count=1)
    if n != 1:
        raise HelperError("mods-available/eap: ocsp { } has no enable line")
    if url:
        body, n = re.subn(r"(?m)^([ \t]*)#?[ \t]*url[ \t]*=.*$", lambda x: x.group(1) + 'url = "%s"' % url, body, count=1)
        if n != 1:
            raise HelperError("mods-available/eap: ocsp { } has no url line")
        body, n = re.subn(r"(?m)^([ \t]*)#?[ \t]*override_cert_url[ \t]*=.*$",
                          lambda x: x.group(1) + "override_cert_url = yes", body, count=1)
    return text[:o.start(2)] + body + text[o.end(2):]


def eap_ocsp_state(text):
    o = re.search(r"(?ms)^([ \t]*)ocsp[ \t]*\{[^\n]*\n(.*?)^\1\}", text or "")
    if not o:
        return None
    e = re.search(r"(?m)^[ \t]*enable[ \t]*=[ \t]*(\S+)", o.group(2))
    u = re.search(r'(?m)^[ \t]*url[ \t]*=[ \t]*"?([^"\n]*)"?', o.group(2))
    return {"enable": bool(e and e.group(1).strip('"').lower() in ("yes", "true", "1")),
            "url": u.group(1).strip() if u else ""}


def check_certificates(cfg, raw):
    """Parse and check the staged certificates file. Returns {file name: bytes} for the files
    that differ from what is installed (SPEC section 30)."""
    try:
        doc = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise HelperError("staged certificates: not valid JSON")
    if not isinstance(doc, dict) or doc.get("format") != 1:
        raise HelperError("staged certificates: format 1 expected")
    unknown = set(doc) - set(CERT_SECTIONS)
    if unknown:
        raise HelperError("staged certificates: unknown section %s" % sorted(unknown)[0])
    want = {}
    if "eap_server" in doc:
        want["eap_cert"], want["eap_key"] = _check_server(cfg, doc["eap_server"], "802.1X server")
    portal = os.path.lexists(cfg["portal_site"])
    if "client_ca" in doc:
        want["eap_ca"] = _check_ca_bundle(cfg, doc["client_ca"], "client CA")
        if portal:
            want["portal_ca"] = want["eap_ca"]
    if "eap_ocsp" in doc:
        o = doc["eap_ocsp"]
        if not isinstance(o, dict) or set(o) != {"enable", "url"} or not isinstance(o["enable"], bool) \
                or not isinstance(o["url"], str):
            raise HelperError("staged certificates: eap_ocsp must be {enable: bool, url: str}")
        if o["url"] and not OCSP_URL_RE.match(o["url"]):
            raise HelperError("staged certificates: the OCSP responder must be an http(s) URL")
        if o["enable"] and not o["url"]:
            raise HelperError("staged certificates: OCSP needs a responder URL")
        live = read_root_file(cert_target(cfg, "eap_conf")[0])
        if live is None:
            raise HelperError("mods-available/eap not found")
        want["eap_conf"] = set_eap_ocsp(live.decode("utf-8", "surrogateescape"), o["enable"], o["url"])
    if "portal_server" in doc:
        name = portal_server_name(cfg)
        if not portal or not name:
            raise HelperError("the portal certificate can be changed only when the portal's nginx site is installed")
        want["portal_cert"], want["portal_key"] = _check_server(cfg, doc["portal_server"], "portal", server_name=name)
    out = {}
    for k, v in want.items():
        data = v.encode("utf-8", "surrogateescape")
        if read_root_file(cert_target(cfg, k)[0]) != data:
            out[k] = data
    return out


def read_cert_files(cfg, names):
    return {n: read_root_file(cert_target(cfg, n)[0]) for n in names}


def install_cert_files(cfg, files):
    """Write (bytes) or remove (None) certificate files; eap_conf keeps the live owner and mode."""
    for name, data in files.items():
        path, uid, gid, mode, _ = cert_target(cfg, name)
        if data is None:
            remove_file(path)
            continue
        d = os.path.dirname(path)
        if not os.path.isdir(d):
            os.makedirs(d, 0o750)
            os.chown(d, 0, gid)
        if name == "eap_conf" and os.path.exists(path):
            st = os.lstat(path)
            uid, gid, mode = st.st_uid, st.st_gid, _plain_mode(st)
        atomic_write(path, data, uid, gid, mode)


def overlay_certs(rd, cfg, files):
    """In a validation copy: put the candidate certificate files in place and point the absolute
    certs/site paths of mods-available/eap and the clients file (RadSec) at the copy."""
    for name, data in files.items():
        rel = cert_target(cfg, name)[4]
        if rel is None:
            continue
        p = os.path.join(rd, rel)
        if data is None:
            if os.path.lexists(p):
                os.unlink(p)
            continue
        os.makedirs(os.path.dirname(p), 0o750, exist_ok=True)
        os.chown(os.path.dirname(p), 0, cfg["freerad_gid"])
        if os.path.lexists(p):
            os.unlink(p)
        atomic_write(p, data, 0, cfg["freerad_gid"], 0o640)
    live = os.path.join(cfg["raddb"], "certs", "site") + "/"
    copy = os.path.join(rd, "certs", "site") + "/"
    for rel in ("mods-available/eap", CLIENTS_NAME):
        p = os.path.join(rd, rel)
        if not os.path.isfile(p) or os.path.islink(p):
            continue
        with open(p, "r", encoding="utf-8", errors="surrogateescape") as fh:
            txt = fh.read()
        if live in txt:
            st = os.lstat(p)
            atomic_write(p, txt.replace(live, copy).encode("utf-8", "surrogateescape"), st.st_uid, st.st_gid,
                         _plain_mode(st))


def portal_reload_and_check(cfg, cert_pem):
    """nginx -t, reload, then the portal must listen and (portal_verify_tls) serve cert_pem."""
    # nginx -t binds the listen sockets and opens its logs and pid file, which this unit's sandbox
    # does not allow: it runs as a transient unit of its own (the helper restarts services anyway)
    rc, out = run([cfg["systemd_run"], "--quiet", "--wait", "--pipe", "--collect", "--service-type=oneshot",
                   cfg["nginx"], "-t", "-q"], 40)
    if rc != 0:
        return False, "nginx -t failed: %s" % tail(out, 3)
    rc, out = run([cfg["systemctl"], "reload", cfg["portal_service"]], 30)
    if rc != 0:
        return False, "nginx reload failed: %s" % tail(out, 3)
    deadline = time.monotonic() + 15
    want = None
    if cert_pem is not None and cfg["portal_verify_tls"]:
        want = _cert_info(cfg, cert_pem.decode())["sha256"]
    addr, name = portal_listen(cfg), portal_server_name(cfg)
    why = "portal not listening on TCP %d" % cfg["portal_port"]
    while time.monotonic() < deadline:
        st = portal_status(cfg)
        if st["portal_active"] and st["portal_listening"]:
            if want is None:
                return True, "portal reloaded"
            if addr and name:
                rc, out = run([cfg["openssl"], "s_client", "-connect", "%s:%d" % (addr, cfg["portal_port"]),
                               "-servername", name], 10, input_data=b"")
                m = PEM_CERT_RE.search(out.replace("\r\n", "\n"))
                if m and _cert_info(cfg, m.group(0))["sha256"] == want:
                    return True, "portal reloaded and serves the new certificate"
                why = "the portal does not serve the new certificate"
            else:
                why = "portal listen address unknown"
        time.sleep(1)
    return False, why


def cert_status(cfg):
    """Read-only facts about the installed certificates (no keys)."""
    def one(name):
        raw = read_root_file(cert_target(cfg, name)[0])
        if raw is None:
            return None
        try:
            blocks = PEM_CERT_RE.findall(raw.decode("utf-8", "replace").replace("\r\n", "\n"))
            out = []
            for b in blocks[:20]:
                i = _cert_info(cfg, b)
                out.append({k: i[k] for k in ("subject", "issuer", "not_before", "not_after", "sha256",
                                              "san", "key", "ca", "expired")})
            return out
        except HelperError as e:
            return [{"error": str(e)}]
    conf = read_root_file(cert_target(cfg, "eap_conf")[0])
    portal = os.path.lexists(cfg["portal_site"])
    return {"eap_server": one("eap_cert"), "client_ca": one("eap_ca"),
            "eap_ocsp": eap_ocsp_state(conf.decode("utf-8", "replace") if conf else None),
            "portal_server": one("portal_cert") if portal else None, "portal_configured": portal,
            "portal_server_name": portal_server_name(cfg) if portal else None}


def act_cert_status(cfg, req):
    r = {"ok": True, "message": "ok"}
    r.update(cert_status(cfg))
    return r


