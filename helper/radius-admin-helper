def version_key(v):
    m = UPDATE_VERSION_RE.match(v or "")
    if not m:
        return None
    x, y, z, pre, n = m.groups()
    return int(x), int(y), int(z), {"dev": 0, "rc": 1, None: 2}[pre], int(n or 0)


def installed_build(cfg):
    raw = read_root_file(cfg["build_file"])
    try:
        data = json.loads(raw.decode()) if raw else {}
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    return {k: str(data.get(k) or "")[:100] for k in ("version", "channel", "commit", "built")}


def pubkey_fingerprint(cfg):
    """SHA-256 of the pinned key's DER form, or None if the key is missing/not root-owned."""
    try:
        st = os.lstat(cfg["update_pubkey"])
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        return None
    raw = read_root_file(cfg["update_pubkey"]) or b""
    m = re.search(rb"-----BEGIN PUBLIC KEY-----(.+?)-----END PUBLIC KEY-----", raw, re.S)
    if not m:
        return None
    try:
        der = base64.b64decode(b"".join(m.group(1).split()), validate=True)
    except ValueError:
        return None
    return hashlib.sha256(der).hexdigest()


def update_state_path(cfg):
    return os.path.join(cfg["work_dir"], "update-state.json")


def read_update_state(cfg):
    raw = read_root_file(update_state_path(cfg))
    try:
        st = json.loads(raw.decode()) if raw else {}
    except ValueError:
        st = {}
    return st if isinstance(st, dict) else {}


def write_update_state(cfg, st):
    atomic_write(update_state_path(cfg), json.dumps(st, sort_keys=True).encode(), 0, 0, 0o600)


def install_unit(cfg, version):
    return "%s@%s.service" % (cfg["update_install_unit"], version)


def unit_state(cfg, unit):
    rc, out = run([cfg["systemctl"], "is-active", unit], 15)
    return (out.strip().splitlines() or ["unknown"])[-1][:32]


def _open_owned(dirfd, name, uid, limit, what, who="the update user"):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=dirfd)
    except FileNotFoundError:
        raise HelperError("%s is missing from the download" % what)
    except OSError as e:
        raise HelperError("cannot open %s: %s" % (what, e.strerror))
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1:
        os.close(fd)
        raise HelperError("%s must be a regular, single-linked file owned by %s" % (what, who))
    if st.st_size > limit:
        os.close(fd)
        raise HelperError("%s is too large" % what)
    return fd


def _copy_out(fd, dst, limit, digest=None):
    """Copy an open file to dst (new, root 0600); returns the number of bytes."""
    total = 0
    out = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            total += len(chunk)
            if total > limit:
                raise HelperError("download grew beyond its expected size")
            if digest is not None:
                digest.update(chunk)
            view = memoryview(chunk)
            while view:
                view = view[os.write(out, view):]
        os.fsync(out)
    finally:
        os.close(out)
    return total


def current_update_state(cfg):
    """update-state.json; a queued/installing state whose unit ended is marked failed."""
    st = read_update_state(cfg)
    if st.get("state") in UPDATE_ACTIVE and UPDATE_VERSION_RE.match(st.get("version", "")):
        unit = install_unit(cfg, st["version"])
        us = unit_state(cfg, unit)
        if us not in ("active", "activating", "reloading"):
            # the install unit ended without writing a result (killed, crashed, rebooted)
            if st.get("state") == "installing" or us == "failed":
                st.update(state="failed", finished=utc_now(),
                          message="the install stopped without a result (journalctl -u %s)" % unit)
                write_update_state(cfg, st)
    return st


def act_update_status(cfg, req):
    st = current_update_state(cfg)
    fp = pubkey_fingerprint(cfg)
    return {"ok": True, "message": "ok", "installed": installed_build(cfg),
            "key_present": fp is not None, "key_fingerprint": fp or "", "state": st}


def _offset(req):
    offset = req.get("offset", 0)
    if isinstance(offset, bool) or not isinstance(offset, int) or not 0 <= offset < 2 ** 53:
        raise HelperError("invalid offset (expected a non-negative integer)")
    return offset


def _log_chunk(log_dir, name_re, path, offset, resp):
    """Part of an install log (`path`, which a state file named) from byte `offset`: at most
    UPDATE_LOG_CHUNK bytes, ending at a line break when there is one (only the newest
    UPDATE_LOG_CHUNK bytes when the caller is further behind; `skipped` counts the rest).
    The file must be directly in log_dir, match name_re, be regular and owned by root."""
    if not path:
        resp["message"] = "no install log yet"
        return resp
    d, name = os.path.split(path)
    if os.path.normpath(d) != log_dir or not name_re.match(name):
        raise HelperError("the state names a file that is not an install log")
    try:
        dirfd = os.open(log_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise HelperError("cannot open %s: %s" % (log_dir, e.strerror))
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=dirfd)
    except FileNotFoundError:
        resp["message"] = "the install log %s is gone" % name
        return resp
    except OSError as e:
        raise HelperError("cannot open the install log: %s" % e.strerror)
    finally:
        os.close(dirfd)
    try:
        fst = os.fstat(fd)
        if not stat.S_ISREG(fst.st_mode) or fst.st_uid != 0:
            raise HelperError("the install log must be a regular file owned by root")
        size = fst.st_size
        if offset > size:                       # another file than the caller read: start again
            offset = 0
        skipped = 0
        if size - offset > UPDATE_LOG_CHUNK:
            skipped = size - UPDATE_LOG_CHUNK - offset
            offset = size - UPDATE_LOG_CHUNK
        os.lseek(fd, offset, os.SEEK_SET)
        data = b""
        while len(data) < UPDATE_LOG_CHUNK:
            chunk = os.read(fd, UPDATE_LOG_CHUNK - len(data))
            if not chunk:
                break
            data += chunk
    finally:
        os.close(fd)
    if data and not data.endswith(b"\n") and b"\n" in data:
        data = data[:data.rindex(b"\n") + 1]   # whole lines; the rest comes next time
    resp.update(log=name, offset=offset + len(data), size=size, skipped=skipped,
                text=data.decode("utf-8", "replace"))
    return resp


def act_update_log(cfg, req):
    """Part of the install log named in update-state.json, from byte `offset` (_log_chunk)."""
    offset = _offset(req)
    st = current_update_state(cfg)
    resp = {"ok": True, "message": "ok", "state": st, "log": "", "offset": 0, "size": 0,
            "skipped": 0, "text": ""}
    path = st.get("log") if isinstance(st.get("log"), str) else ""
    return _log_chunk(cfg["update_log_dir"], UPDATE_LOG_RE, path, offset, resp)


def act_update_check(cfg, req):
    rc, out = run([cfg["systemctl"], "start", "--no-block", cfg["update_check_unit"]], 15)
    if rc != 0:
        raise HelperError("could not start %s: %s" % (cfg["update_check_unit"], tail(out, 5)))
    return {"ok": True, "message": "update check started"}


def act_update_install(cfg, req):
    version = req.get("version")
    if not isinstance(version, str) or not UPDATE_VERSION_RE.match(version):
        raise HelperError("invalid version (expected X.Y.Z, X.Y.Z-rc.N or X.Y.Z-dev.N)")
    allow_downgrade = req.get("allow_downgrade") is True
    actor = req.get("actor") if isinstance(req.get("actor"), str) and ACTOR_RE.match(req["actor"]) else ""
    if pubkey_fingerprint(cfg) is None:
        raise HelperError("updates are not set up: no root-owned signing key at %s" % cfg["update_pubkey"])
    try:
        owner = pwd.getpwnam(cfg["update_owner"]).pw_uid
    except KeyError:
        raise HelperError("helper.conf: unknown update_owner %s" % cfg["update_owner"])
    limit = cfg["update_max_mib"] * 1024 * 1024
    ensure_work_dirs(cfg)
    with Lock(cfg, "update.lock", "another update"):
        st = read_update_state(cfg)
        if st.get("state") in UPDATE_ACTIVE and UPDATE_VERSION_RE.match(st.get("version", "")) \
                and unit_state(cfg, install_unit(cfg, st["version"])) in ("active", "activating"):
            raise HelperError("an update to %s is already running" % st["version"])
        try:
            dirfd = os.open(os.path.join(cfg["update_dir"], version),
                            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError:
            raise HelperError("version %s has not been downloaded" % version)
        work = os.path.join(cfg["work_dir"], "update")
        shutil.rmtree(work, ignore_errors=True)
        os.makedirs(os.path.join(work, version), mode=0o700)
        dst = os.path.join(work, version)
        try:
            dst_st = os.fstat(dirfd)
            if dst_st.st_uid != owner or dst_st.st_mode & 0o002:
                raise HelperError("the download directory must belong to the update user")
            for name, lim in (("manifest.json", MAX_MANIFEST), ("manifest.json.sig", MAX_SIGNATURE)):
                fd = _open_owned(dirfd, name, owner, lim, name)
                try:
                    _copy_out(fd, os.path.join(dst, name), lim)
                finally:
                    os.close(fd)
            rc, out = run([cfg["openssl"], "dgst", "-sha384", "-verify", cfg["update_pubkey"],
                           "-signature", os.path.join(dst, "manifest.json.sig"),
                           os.path.join(dst, "manifest.json")], 30)
            if rc != 0 or "Verified OK" not in out:
                raise HelperError("the manifest signature does not verify with the pinned key; nothing installed")
            with open(os.path.join(dst, "manifest.json"), encoding="utf-8") as fh:
                man = json.load(fh)
            b = man.get("bundle") if isinstance(man, dict) else None
            if not (isinstance(man, dict) and man.get("format") == 1 and man.get("product") == "radius-admin"
                    and man.get("version") == version and man.get("channel") in UPDATE_CHANNELS
                    and isinstance(b, dict) and b.get("name") == "radius-admin-%s.tar.gz" % version
                    and isinstance(b.get("size"), int) and 0 < b["size"] <= limit
                    and isinstance(b.get("sha384"), str) and re.match(r"^[0-9a-f]{96}$", b["sha384"])):
                raise HelperError("the signed manifest does not describe version %s" % version)
            digest = hashlib.sha384()
            fd = _open_owned(dirfd, b["name"], owner, b["size"], "the bundle")
            try:
                size = _copy_out(fd, os.path.join(dst, "bundle.tar.gz"), b["size"], digest)
            finally:
                os.close(fd)
            if size != b["size"] or digest.hexdigest() != b["sha384"]:
                raise HelperError("the bundle does not match its signed SHA-384; nothing installed")
        except BaseException:
            shutil.rmtree(work, ignore_errors=True)
            raise
        finally:
            os.close(dirfd)
        current = installed_build(cfg).get("version", "")
        ck, nk = version_key(current), version_key(version)
        if ck is not None and nk <= ck and not allow_downgrade:
            shutil.rmtree(work, ignore_errors=True)
            raise HelperError("%s is not newer than the installed %s; allow a downgrade to install it"
                              % (version, current))
        st = {"state": "queued", "version": version, "from": current, "channel": man["channel"],
              "restarts_freeradius": man.get("restarts_freeradius") is True, "actor": actor or "",
              "requested": utc_now(), "message": "queued"}
        write_update_state(cfg, st)
        unit = install_unit(cfg, version)
        rc, out = run([cfg["systemctl"], "start", "--no-block", unit], 15)
        if rc != 0:
            st.update(state="failed", finished=utc_now(), message="could not start %s" % unit)
            write_update_state(cfg, st)
            raise HelperError("could not start %s: %s" % (unit, tail(out, 5)))
    return {"ok": True, "message": "update to %s started" % version, "version": version,
            "restarts_freeradius": st["restarts_freeradius"]}


# --------------------------------------------------------------------------- integrations
# Second-factor providers installed on this server (SPEC section 29). The request names a
# provider by id; everything else about it (file names, download URL, service, port) is
# fixed here. Builds are checked against a signed catalog that ships with each release.

INTEGRATION_VERSION_RE = re.compile(r"(\d{1,4})\.(\d{1,4})\.(\d{1,4})")
INTEGRATION_LOG_RE = re.compile(r"^integration-[a-z][a-z0-9-]{0,31}-\d{8}T\d{6}Z\.log\Z")
SHA256_RE = re.compile(r"[0-9a-f]{64}")
CATALOG_MAX = 256 * 1024
CATALOG_MAX_ENTRIES = 500
INTEGRATIONS = {
    "duo": {
        "label": "Duo Authentication Proxy",
        "file": re.compile(r"duoauthproxy-(\d{1,4}\.\d{1,4}\.\d{1,4})-src\.tgz"),
        "url_prefix": "https://dl.duosecurity.com/",
        "unit": "duoauthproxy.service",
        "listen": "127.0.0.1:18120",
        "api_host": re.compile(r"api-[a-z0-9]{1,16}\.duosecurity\.com"),
        "packages": ("build-essential", "libffi-dev", "zlib1g-dev", "perl"),
        "min_free_mib": 1024,
    },
}
DPKG_QUERY = "/usr/bin/dpkg-query"
INTEGRATION_ACTIVE = ("queued", "installing", "removing")
OS_RELEASE = "/etc/os-release"


def fips_on(cfg):
    try:
        with open(cfg["fips_file"]) as fh:
            return fh.read().strip() == "1"
    except OSError:
        return False


def _integration(req):
    pid = req.get("id")
    if not isinstance(pid, str) or pid not in INTEGRATIONS:
        raise HelperError("unknown integration")
    return pid, INTEGRATIONS[pid]


def _read_root_owned(path, limit):
    """A root-owned regular file that only root can change; None when it does not exist."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise HelperError("cannot read %s: %s" % (path, e.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise HelperError("%s must be a regular file owned by root and writable only by root" % path)
        if st.st_size > limit:
            raise HelperError("%s is too large" % path)
        with os.fdopen(fd, "rb", closefd=False) as fh:
            return fh.read(limit + 1)
    finally:
        os.close(fd)


def _verify_signed(cfg, data, sig):
    """True when `sig` is a valid ECDSA P-384 / SHA-384 signature of `data` by the pinned
    update key (the key that signs release manifests, SPEC section 16)."""
    if pubkey_fingerprint(cfg) is None:
        return False
    d = tempfile.mkdtemp(prefix="catalog.", dir=cfg["work_dir"])
    try:
        dp, sp = os.path.join(d, "catalog.json"), os.path.join(d, "catalog.json.sig")
        atomic_write(dp, data, 0, 0, 0o600)
        atomic_write(sp, sig, 0, 0, 0o600)
        rc, out = run([cfg["openssl"], "dgst", "-sha384", "-verify", cfg["update_pubkey"], "-signature", sp, dp], 30)
        return rc == 0 and "Verified OK" in out
    finally:
        shutil.rmtree(d, ignore_errors=True)


def _check_catalog(raw):
    """Parse a signature-verified catalog: format 1, serial, entries (each provider known,
    file name and URL exactly as this helper expects for that provider)."""
    try:
        cat = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise HelperError("the integrations catalog is not JSON")
    serial = cat.get("serial") if isinstance(cat, dict) else None
    if not (isinstance(cat, dict) and cat.get("format") == 1 and isinstance(serial, int)
            and not isinstance(serial, bool) and 1 <= serial < 2 ** 31
            and isinstance(cat.get("entries"), list) and len(cat["entries"]) <= CATALOG_MAX_ENTRIES):
        raise HelperError("the integrations catalog has an unknown format")
    entries = []
    for e in cat["entries"]:
        prov = INTEGRATIONS.get(e.get("provider")) if isinstance(e, dict) else None
        ok = prov is not None
        if ok:
            ver, name, size = e.get("version"), e.get("file"), e.get("size")
            m = prov["file"].fullmatch(name) if isinstance(name, str) else None
            tested = e.get("fips_tested", [])
            ok = (isinstance(ver, str) and INTEGRATION_VERSION_RE.fullmatch(ver) is not None
                  and m is not None and m.group(1) == ver and e.get("url") == prov["url_prefix"] + name
                  and isinstance(size, int) and not isinstance(size, bool) and 0 < size < 2 ** 31
                  and isinstance(e.get("sha256"), str) and SHA256_RE.fullmatch(e["sha256"]) is not None
                  and isinstance(e.get("fips", False), bool) and isinstance(e.get("withdrawn", False), bool)
                  and isinstance(tested, list) and len(tested) <= 10
                  and all(isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,40}", x) for x in tested)
                  and (e.get("min_radius_admin") is None
                       or (isinstance(e["min_radius_admin"], str) and version_key(e["min_radius_admin"]) is not None)))
        if not ok:
            raise HelperError("the integrations catalog has an invalid entry")
        entries.append({"provider": e["provider"], "version": e["version"], "file": e["file"], "url": e["url"],
                        "size": e["size"], "sha256": e["sha256"], "fips": e.get("fips") is True,
                        "fips_tested": list(e.get("fips_tested", [])), "withdrawn": e.get("withdrawn") is True,
                        "min_radius_admin": e.get("min_radius_admin") or ""})
    return {"serial": serial, "entries": entries}


def load_catalog(cfg):
    """The newest verified catalog: the one this release ships (integration_catalog and
    integration_catalog.sig, root-owned) or the one the helper kept from an earlier release,
    whichever has the higher serial. An older release's catalog never replaces a newer one,
    so a downgrade cannot bring back a withdrawn build. Without either: serial 0, no entries."""
    ensure_work_dirs(cfg)
    kept_p = os.path.join(cfg["work_dir"], "integrations-catalog.json")
    best, message = None, ""
    kept_raw, kept_sig = read_root_file(kept_p), read_root_file(kept_p + ".sig")
    if kept_raw is not None and kept_sig is not None and _verify_signed(cfg, kept_raw, kept_sig):
        best = dict(_check_catalog(kept_raw), source="kept")
    raw = _read_root_owned(cfg["integration_catalog"], CATALOG_MAX)
    sig = _read_root_owned(cfg["integration_catalog"] + ".sig", 1024)
    if raw is not None:
        if sig is None or not _verify_signed(cfg, raw, sig):
            message = "the catalog of this release is not signed with the pinned key; it is ignored"
        else:
            cat = _check_catalog(raw)
            if best is None or cat["serial"] > best["serial"]:
                atomic_write(kept_p, raw, 0, 0, 0o600)
                atomic_write(kept_p + ".sig", sig, 0, 0, 0o600)
                best = dict(cat, source="release")
            elif cat["serial"] < best["serial"]:
                message = ("the catalog of this release (serial %d) is older than the one kept (serial %d);"
                           " the kept one is used" % (cat["serial"], best["serial"]))
            elif raw != kept_raw:
                message = ("the catalog of this release differs from the one kept with the same serial %d;"
                           " the kept one is used" % cat["serial"])
            else:
                best["source"] = "release"
    if best is None:
        best = {"serial": 0, "entries": [], "source": "none"}
    best["message"] = message
    return best


def integration_state_path(cfg):
    return os.path.join(cfg["work_dir"], "integration-state.json")


def read_integration_state(cfg):
    raw = read_root_file(integration_state_path(cfg))
    try:
        st = json.loads(raw.decode()) if raw else {}
    except ValueError:
        st = {}
    return {k: v for k, v in st.items() if k in INTEGRATIONS and isinstance(v, dict)} if isinstance(st, dict) else {}


def write_integration_state(cfg, st):
    atomic_write(integration_state_path(cfg), json.dumps(st, sort_keys=True).encode(), 0, 0, 0o600)


def integration_unit(cfg, pid, action="install"):
    key = "integration_remove_unit" if action == "remove" else "integration_install_unit"
    return "%s@%s.service" % (cfg[key], pid)


def current_integration_state(cfg):
    """The state file, with an install whose unit is no longer running marked failed."""
    st = read_integration_state(cfg)
    changed = False
    for pid, s in st.items():
        unit = integration_unit(cfg, pid, s.get("action", "install"))
        if s.get("state") in INTEGRATION_ACTIVE and unit_state(cfg, unit) not in ("active", "activating"):
            s.update(state="failed", finished=utc_now(),
                     message="the %s stopped without finishing (journalctl -u %s)" % (s.get("action", "install"), unit))
            changed = True
    if changed:
        write_integration_state(cfg, st)
    return st


def _installed(cfg, pid):
    """What the installer recorded about an installed provider (<duo_dir>/.radius-admin)."""
    if pid != "duo":
        return {}
    try:
        raw = _read_root_owned(os.path.join(cfg["duo_dir"], ".radius-admin"), 64 * 1024)
        info = json.loads(raw.decode()) if raw else {}
    except (HelperError, ValueError, UnicodeDecodeError):
        return {"damaged": True}
    keep = ("version", "sha256", "verified", "installed", "fips")
    return {k: info[k] for k in keep if k in info} if isinstance(info, dict) else {}


def _udp_bound(cfg, addr):
    rc, out = run([cfg["ss"], "-H", "-lun"], 10)
    return rc == 0 and any(len(c) >= 5 and c[3] == addr for c in (ln.split() for ln in out.splitlines()))


def act_integration_status(cfg, req):
    st = current_integration_state(cfg)
    out = {}
    for pid, prov in INTEGRATIONS.items():
        inst = _installed(cfg, pid)
        active = bool(inst) and unit_state(cfg, prov["unit"]) == "active"
        out[pid] = {"label": prov["label"], "installed": inst, "service_active": active,
                    "listening": active and _udp_bound(cfg, prov["listen"]), "state": st.get(pid, {})}
    return {"ok": True, "message": "ok", "fips_enabled": fips_on(cfg), "integrations": out}


def act_integration_catalog(cfg, req):
    cat = load_catalog(cfg)
    return {"ok": True, "message": cat["message"] or "ok", "serial": cat["serial"], "source": cat["source"],
            "fips_enabled": fips_on(cfg), "entries": cat["entries"]}


def _os_release():
    out = {}
    try:
        with open(OS_RELEASE, encoding="utf-8", errors="replace") as fh:
            for line in fh.read(16384).splitlines():
                m = re.fullmatch(r"([A-Z_]{1,32})=(.*)", line.strip())
                if m:
                    out[m.group(1)] = m.group(2).strip().strip("\"'")[:100]
    except OSError:
        pass
    return out


def _deb_installed(pkg):
    rc, out = run([DPKG_QUERY, "-W", "-f=${Status}", pkg], 15)
    return rc == 0 and "install ok installed" in out


def act_integration_preflight(cfg, req):
    """Read-only checks before an install: disk space, OS, build packages, FIPS mode and,
    with `api_host` (the provider's API hostname, strict pattern), a TCP connection to it."""
    pid, prov = _integration(req)
    api = req.get("api_host")
    if api is not None and (not isinstance(api, str) or not prov["api_host"].fullmatch(api)):
        raise HelperError("invalid API hostname")
    checks = []
    seen = set()
    for path in (os.path.dirname(cfg["duo_dir"]) or "/", cfg["work_dir"]):
        try:
            sv = os.statvfs(path)
        except OSError:
            continue
        if sv.f_fsid in seen:
            continue
        seen.add(sv.f_fsid)
        free = sv.f_bavail * sv.f_frsize // (1024 * 1024)
        checks.append({"check": "disk", "ok": free >= prov["min_free_mib"],
                       "detail": "%d MiB free for %s (needs %d MiB)" % (free, path, prov["min_free_mib"])})
    osr = _os_release()
    checks.append({"check": "os", "ok": osr.get("ID") in ("ubuntu", "debian"),
                   "detail": osr.get("PRETTY_NAME") or "unknown operating system"})
    if os.path.exists(DPKG_QUERY):
        missing = [p for p in prov["packages"] if not _deb_installed(p)]
        checks.append({"check": "packages", "ok": True,
                       "detail": "build packages installed" if not missing
                       else "the install adds: " + ", ".join(missing)})
    if api is not None:
        try:
            socket.create_connection((api, 443), timeout=5).close()
            checks.append({"check": "api", "ok": True, "detail": "%s:443 answers" % api})
        except OSError as e:
            checks.append({"check": "api", "ok": False,
                           "detail": "cannot reach %s:443 (%s)" % (api, e.strerror or type(e).__name__)})
    return {"ok": True, "message": "ok", "ready": all(c["ok"] for c in checks), "checks": checks,
            "fips_enabled": fips_on(cfg)}


def _catalog_entry(cat, pid, version):
    return next((e for e in cat["entries"] if e["provider"] == pid and e["version"] == version), None)


def act_integration_fetch(cfg, req):
    """Start the download of a provider build by the unprivileged fetch unit (the only
    component that downloads it; the helper never does)."""
    pid, prov = _integration(req)
    version = req.get("version")
    if not isinstance(version, str) or not INTEGRATION_VERSION_RE.fullmatch(version):
        raise HelperError("invalid version (expected X.Y.Z)")
    entry = _catalog_entry(load_catalog(cfg), pid, version)
    if entry is not None and entry["withdrawn"]:
        raise HelperError("%s %s was withdrawn from the catalog" % (prov["label"], version))
    if fips_on(cfg) and not (entry is not None and entry["fips"]):
        raise HelperError("in FIPS mode only builds that the signed catalog lists as FIPS-capable can be installed")
    unit = "%s@%s-%s.service" % (cfg["integration_fetch_unit"], pid, version)
    rc, out = run([cfg["systemctl"], "start", "--no-block", unit], 15)
    if rc != 0:
        raise HelperError("could not start %s: %s" % (unit, tail(out, 5)))
    return {"ok": True, "message": "download of %s %s started" % (prov["label"], version),
            "listed": entry is not None}


def act_integration_install(cfg, req):
    """Copy a downloaded or uploaded build from integration_dir into the helper's own
    directory, check it against the signed catalog (or, in standard mode only, against a
    SHA-256 the admin pasted), and start the install unit."""
    pid, prov = _integration(req)
    name = req.get("file")
    m = prov["file"].fullmatch(name) if isinstance(name, str) else None
    if m is None:
        raise HelperError("invalid file name for %s" % prov["label"])
    version = m.group(1)
    pasted = req.get("sha256")
    if pasted is not None and (not isinstance(pasted, str) or not SHA256_RE.fullmatch(pasted)):
        raise HelperError("invalid SHA-256 (expected 64 lower-case hex digits)")
    actor = req.get("actor") if isinstance(req.get("actor"), str) and ACTOR_RE.match(req["actor"]) else ""
    try:
        owner = pwd.getpwnam(cfg["integration_owner"]).pw_uid
    except KeyError:
        raise HelperError("helper.conf: unknown integration_owner %s" % cfg["integration_owner"])
    limit = cfg["integration_max_mib"] * 1024 * 1024
    fips = fips_on(cfg)
    unit = integration_unit(cfg, pid)
    ensure_work_dirs(cfg)
    with Lock(cfg, "integration.lock", "another integration install"):
        st = read_integration_state(cfg)
        cur = st.get(pid) or {}
        if cur.get("state") in INTEGRATION_ACTIVE and unit_state(
                cfg, integration_unit(cfg, pid, cur.get("action", "install"))) in ("active", "activating"):
            raise HelperError("an install or removal of %s is already running" % prov["label"])
        cat = load_catalog(cfg)
        try:
            dirfd = os.open(cfg["integration_dir"], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError as e:
            raise HelperError("cannot open %s: %s" % (cfg["integration_dir"], e.strerror))
        work = os.path.join(cfg["work_dir"], "integration", pid)
        try:
            dst = os.fstat(dirfd)
            if dst.st_uid != owner or dst.st_mode & 0o002:
                raise HelperError("%s must belong to %s" % (cfg["integration_dir"], cfg["integration_owner"]))
            shutil.rmtree(work, ignore_errors=True)
            os.makedirs(work, mode=0o700)
            digest = hashlib.sha256()
            fd = _open_owned(dirfd, name, owner, limit, name, "the portal user")
            try:
                size = _copy_out(fd, os.path.join(work, name), limit, digest)
            finally:
                os.close(fd)
            h = digest.hexdigest()
            entry = next((e for e in cat["entries"] if e["provider"] == pid and e["sha256"] == h), None)
            if entry is not None:
                if entry["size"] != size or entry["version"] != version:
                    raise HelperError("%s matches the catalog entry of %s %s only partly; nothing installed"
                                      % (name, prov["label"], entry["version"]))
                if entry["withdrawn"]:
                    raise HelperError("%s %s was withdrawn from the catalog; nothing installed"
                                      % (prov["label"], version))
                if fips and not entry["fips"]:
                    raise HelperError("in FIPS mode only builds that the signed catalog lists as FIPS-capable can"
                                      " be installed; %s %s is not one" % (prov["label"], version))
                need = version_key(entry["min_radius_admin"]) if entry["min_radius_admin"] else None
                have = version_key(installed_build(cfg).get("version", ""))
                if need is not None and have is not None and have < need:
                    raise HelperError("%s %s needs radius-admin %s or later"
                                      % (prov["label"], version, entry["min_radius_admin"]))
                verified = "catalog"
            elif fips:
                raise HelperError("in FIPS mode only builds that the signed catalog lists as FIPS-capable can be"
                                  " installed; %s is not in the catalog" % name)
            elif pasted is None:
                raise HelperError("%s is not in the signed catalog. Its SHA-256 is %s: compare it with the value"
                                  " the vendor publishes and enter it to install the build unverified" % (name, h))
            elif pasted != h:
                raise HelperError("the SHA-256 of %s is %s, not the one entered; nothing installed" % (name, h))
            else:
                verified = "pasted-hash"
            info = {"id": pid, "version": version, "file": name, "sha256": h, "size": size, "verified": verified,
                    "fips": fips, "catalog_serial": cat["serial"]}
            atomic_write(os.path.join(work, "request.json"), json.dumps(info, sort_keys=True).encode(), 0, 0, 0o600)
        except BaseException:
            shutil.rmtree(work, ignore_errors=True)
            raise
        finally:
            os.close(dirfd)
        st[pid] = {"state": "queued", "action": "install", "version": version, "sha256": h, "verified": verified,
                   "actor": actor, "requested": utc_now(), "message": "queued", "log": ""}
        write_integration_state(cfg, st)
        rc, out = run([cfg["systemctl"], "start", "--no-block", unit], 15)
        if rc != 0:
            st[pid].update(state="failed", finished=utc_now(), message="could not start %s" % unit)
            write_integration_state(cfg, st)
            raise HelperError("could not start %s: %s" % (unit, tail(out, 5)))
    return {"ok": True, "message": "install of %s %s started" % (prov["label"], version), "version": version,
            "verified": verified, "sha256": h}


MFA_LISTEN_MARKER = re.compile(r"(?m)^[ \t]*virtual_server[ \t]*=[ \t]*radius-admin-mfa-primary[ \t]*$")


def act_integration_remove(cfg, req):
    """Start the removal of an installed provider. Refused while FreeRADIUS still sends
    logins to it (the live clients file has the Duo listener) or an install runs."""
    pid, prov = _integration(req)
    actor = req.get("actor") if isinstance(req.get("actor"), str) and ACTOR_RE.match(req["actor"]) else ""
    if not _installed(cfg, pid):
        raise HelperError("%s is not installed by radius-admin" % prov["label"])
    live = read_root_file(cfg["clients_target"]) or b""
    if MFA_LISTEN_MARKER.search(live.decode("utf-8", "replace")):
        raise HelperError("FreeRADIUS still uses %s: turn the provider off and apply the changes first" % prov["label"])
    ensure_work_dirs(cfg)
    with Lock(cfg, "integration.lock", "another integration install"):
        st = read_integration_state(cfg)
        cur = st.get(pid) or {}
        if cur.get("state") in INTEGRATION_ACTIVE and unit_state(
                cfg, integration_unit(cfg, pid, cur.get("action", "install"))) in ("active", "activating"):
            raise HelperError("an install or removal of %s is already running" % prov["label"])
        st[pid] = {"state": "queued", "action": "remove", "actor": actor, "requested": utc_now(),
                   "message": "removal queued", "log": "", "version": (_installed(cfg, pid) or {}).get("version", "")}
        write_integration_state(cfg, st)
        unit = integration_unit(cfg, pid, "remove")
        rc, out = run([cfg["systemctl"], "start", "--no-block", unit], 15)
        if rc != 0:
            st[pid].update(state="failed", finished=utc_now(), message="could not start %s" % unit)
            write_integration_state(cfg, st)
            raise HelperError("could not start %s: %s" % (unit, tail(out, 5)))
    return {"ok": True, "message": "removal of %s started" % prov["label"]}


_TEST_REDACT = re.compile(r"(?i)(skey|secret|password)[^\n]*")


def act_integration_test(cfg, req):
    """Duo's own connectivity tool (reads the applied configuration, tests the Duo API and
    the primary authentication server). Output with secret-looking lines redacted."""
    pid, prov = _integration(req)
    if not _duo_ready(cfg):
        raise HelperError("%s is not installed" % prov["label"])
    tool = os.path.join(cfg["duo_dir"], "usr", "local", "bin", "authproxy_connectivity_tool")
    try:
        st = os.stat(tool)
    except OSError:
        raise HelperError("the connectivity tool of %s is missing" % prov["label"])
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise HelperError("the connectivity tool must be a root-owned file only root can change")
    # Its own transient unit: the tool checks that the proxy's port is free and skips that check
    # when the listener is the running proxy, which it finds by mapping the socket to a process
    # (/proc/<pid>/fd of the service user: CAP_SYS_PTRACE). The helper itself has no ptrace, so
    # inside its sandbox every running proxy looked like "Unknown Process, PID -1". The unit gets
    # that capability, DAC override for Duo's log directory, and write access to that only.
    sandbox = ("ProtectSystem=strict", "ReadWritePaths=-%s" % os.path.join(cfg["duo_dir"], "log"),
               "CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH",
               "NoNewPrivileges=yes", "PrivateTmp=yes", "PrivateDevices=yes", "ProtectHome=yes",
               "ProtectKernelTunables=yes", "ProtectKernelModules=yes", "ProtectKernelLogs=yes",
               "ProtectControlGroups=yes", "ProtectClock=yes", "ProtectHostname=yes",
               "RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK", "RestrictNamespaces=yes",
               "RestrictRealtime=yes", "RestrictSUIDSGID=yes", "LockPersonality=yes", "RuntimeMaxSec=115")
    argv = [cfg["systemd_run"], "--quiet", "--wait", "--pipe", "--collect", "--service-type=oneshot"]
    for prop in sandbox:
        argv += ["-p", prop]
    rc, out = run(argv + ["--", tool], 120)
    text = _TEST_REDACT.sub(lambda m: m.group(1) + " [redacted]", tail(out, 200))
    return {"ok": True, "message": "the connectivity check passed" if rc == 0 else "the connectivity check found problems",
            "passed": rc == 0, "output": text}


PUSH_USER_RE = re.compile(r"[A-Za-z0-9._@-]{1,64}")
PUSH_USER_WAIT = 30          # seconds between two test pushes to the same user
PUSH_PER_HOUR = 10           # test pushes per hour, all users
PUSH_TIMEOUT = 70            # Duo waits up to 60 s for the person to answer


def _duo_api(cfg, host, ikey, skey, path, params, timeout):
    """One POST to Duo's Auth API, signed with signature version 5: HMAC-SHA512 over the date,
    method, host, path, the (empty) query, the SHA-512 of the JSON body and of the (absent)
    X-Duo headers. Never the SHA-1 version 2 scheme (rule 6). TLS 1.2+, certificate checked
    against the system CAs and the API host name. Returns Duo's JSON object."""
    body = json.dumps(params, sort_keys=True, separators=(",", ":"))
    date = email.utils.formatdate()
    canon = "\n".join([date, "POST", host.lower(), path, "", hashlib.sha512(body.encode()).hexdigest(),
                       hashlib.sha512(b"").hexdigest()])
    sig = hmac.new(skey.encode(), canon.encode(), hashlib.sha512).hexdigest()
    auth = "Basic " + base64.b64encode(("%s:%s" % (ikey, sig)).encode()).decode()
    ctx = ssl.create_default_context(cafile=cfg["duo_api_cafile"] or None)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    addr = (host, 443)
    if cfg["duo_api_connect"]:
        ip, port = cfg["duo_api_connect"].split(":")
        addr = (ip, int(port))
    raw = socket.create_connection(addr, timeout=timeout)
    conn = http.client.HTTPSConnection(host, 443, timeout=timeout, context=ctx)
    try:
        conn.sock = ctx.wrap_socket(raw, server_hostname=host)
        conn.request("POST", path, body=body.encode(), headers={
            "Authorization": auth, "Date": date, "Host": host, "Content-Type": "application/json",
            "User-Agent": "radius-admin-helper"})
        r = conn.getresponse()
        data = r.read(64 * 1024)
    finally:
        conn.close()
    try:
        out = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise HelperError("Duo answered HTTP %d without JSON" % r.status)
    if not isinstance(out, dict):
        raise HelperError("Duo answered HTTP %d with unexpected JSON" % r.status)
    return out


def _push_tries(cfg, now):
    """The last hour's requests to Duo: [[time, user hash, pushed]] (work_dir/push-test.json)."""
    path = os.path.join(cfg["work_dir"], "push-test.json")
    try:
        tries = json.loads((read_root_file(path) or b"{}").decode("utf-8")).get("tries", [])
        return path, [[float(t), str(h), p is True] for t, h, p in tries if now - float(t) < 3600]
    except (ValueError, TypeError, AttributeError):
        return path, []


def _push_rate(cfg, user, pushed=False):
    """Rate limit for test pushes, kept with a hash of the username, never the name. Without
    `pushed`: check and record a request to Duo (PUSH_PER_HOUR in all; refused while a push to
    this user was sent less than PUSH_USER_WAIT seconds ago). With `pushed`: record that this
    request goes on to send a push, which starts the user's wait. A request that Duo answers
    before any push (not enrolled, no access, bypass) does not hold up the next one."""
    now = time.time()
    who = hashlib.sha256(user.lower().encode()).hexdigest()[:16]
    with Lock(cfg, "push-test.lock", "another test push"):
        path, tries = _push_tries(cfg, now)
        if pushed:
            for t in reversed(tries):
                if t[1] == who:
                    t[2] = True
                    break
        else:
            last = max((t for t, h, p in tries if h == who and p), default=None)
            if last is not None and now - last < PUSH_USER_WAIT:
                raise HelperError("a test push to this user was sent %d s ago; wait %d s"
                                  % (now - last, PUSH_USER_WAIT - (now - last) + 1))
            if len(tries) >= PUSH_PER_HOUR:
                raise HelperError("at most %d test pushes an hour; try again later" % PUSH_PER_HOUR)
            tries.append([now, who, False])
        atomic_write(path, json.dumps({"tries": tries}).encode(), 0, 0, 0o600)


def act_integration_push_test(cfg, req):
    """Send a Duo Push to one user with the applied configuration's keys (SPEC section 29.3):
    preauth, then auth with factor push. Returns only result (allow, deny, timeout,
    not_enrolled, error), Duo's status message and whether a push was sent; never keys."""
    pid, prov = _integration(req)
    user = req.get("username")
    if not isinstance(user, str) or not PUSH_USER_RE.fullmatch(user):
        raise HelperError("username must be 1-64 letters, digits, dots, underscores, @ or hyphens")
    if not _duo_ready(cfg):
        raise HelperError("%s is not installed" % prov["label"])
    raw = read_root_file(duo_cfg_path(cfg))
    if not raw or not raw.startswith(b"; radius-admin"):
        raise HelperError("Duo still runs its sample configuration: apply the Duo settings first")
    sec = check_duo_config(raw, fips_on(cfg))["radius_server_auto"]
    host, ikey, skey = sec["api_host"], sec["ikey"], sec["skey"]
    if not prov["api_host"].fullmatch(host):
        raise HelperError("the applied configuration names an unexpected API host")
    ensure_work_dirs(cfg)
    _push_rate(cfg, user)

    sent = []

    def outcome(result, msg):
        log(syslog.LOG_INFO, "integration_push_test result=%s pushed=%s" % (result, bool(sent)))
        return {"ok": True, "message": "test push: %s" % result, "result": result,
                "status_msg": str(msg or "")[:200], "pushed": bool(sent)}

    try:
        pre = _duo_api(cfg, host, ikey, skey, "/auth/v2/preauth", {"username": user}, 15)
        if pre.get("stat") != "OK":
            return outcome("error", pre.get("message_detail") or pre.get("message") or "Duo refused the request")
        p = pre.get("response") if isinstance(pre.get("response"), dict) else {}
        if p.get("result") == "enroll":
            return outcome("not_enrolled", p.get("status_msg") or "the user is not enrolled in Duo")
        if p.get("result") in ("allow", "deny"):
            return outcome(p["result"], p.get("status_msg"))
        if p.get("result") != "auth":
            return outcome("error", "unexpected preauth answer")
        _push_rate(cfg, user, pushed=True)
        sent.append(True)
        res = _duo_api(cfg, host, ikey, skey, "/auth/v2/auth",
                       {"username": user, "factor": "push", "device": "auto"}, PUSH_TIMEOUT)
    except (OSError, ssl.SSLError, http.client.HTTPException) as e:
        return outcome("error", "cannot reach Duo: %s" % (e.__class__.__name__ if not str(e) else e))
    if res.get("stat") != "OK":
        return outcome("error", res.get("message_detail") or res.get("message") or "Duo refused the request")
    a = res.get("response") if isinstance(res.get("response"), dict) else {}
    if a.get("status") == "timeout":
        return outcome("timeout", a.get("status_msg"))
    if a.get("result") in ("allow", "deny"):
        return outcome(a["result"], a.get("status_msg"))
    return outcome("error", "unexpected auth answer")


