VERSION = "1.0"
DEFAULT_CONFIG = "/etc/radius-admin/helper.conf"
MAX_REQUEST = 64 * 1024
MAX_STAGED = 1024 * 1024
OUTPUT_LINES = 200
BACKUP_ID_RE = re.compile(r"^\d{8}T\d{6}Z$")
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"}
ACTIONS = ("status", "validate", "apply", "rollback")

POLICY_NAME = "radius-admin"                 # <raddb>/policy.d/radius-admin
CLIENTS_NAME = "radius-admin-clients.conf"   # <raddb>/radius-admin-clients.conf
STAGED_POLICY = "policy"
STAGED_CLIENTS = "clients"


class HelperError(Exception):
    """An expected failure, reported to the caller with ok=false."""


# --------------------------------------------------------------------------- config

