def _abs(cfg, key):
    v = cfg[key]
    if not v.startswith("/") or "\n" in v or "\0" in v:
        raise HelperError("helper.conf: %s must be an absolute path" % key)
    return os.path.normpath(v)


def load_config(path):
    """Load [helper] settings from a root-owned, non-writable-by-others file."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise HelperError("cannot open helper config %s: %s" % (path, e.strerror))
    try:
        st = os.fstat(fd)
        with os.fdopen(fd, "r", encoding="utf-8", closefd=False) as fh:
            text = fh.read(65536)
    finally:
        os.close(fd)
    cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=("#", ";"))
    cp.read_string(text, source=path)
    cfg = dict(CONFIG_DEFAULTS)
    if cp.has_section("helper"):
        for k, v in cp.items("helper"):
            if k not in CONFIG_DEFAULTS:
                raise HelperError("helper.conf: unknown key %r" % k)
            cfg[k] = v.strip()
    if cfg["require_root_config"].lower() in ("1", "true", "yes", "on"):
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise HelperError("helper config %s must be a regular file owned by root "
                              "and not group/world writable" % path)
    for key in ("radiusd", "raddb", "staging_dir", "work_dir", "systemctl", "runuser",
                "ss", "fips_file", "update_dir", "update_pubkey", "openssl", "build_file", "portal_site",
                "update_log_dir", "integration_dir", "integration_catalog", "integration_log_dir", "duo_dir",
                "portal_tls_dir", "nginx", "systemd_run"):
        cfg[key] = _abs(cfg, key)
    if not re.match(r"^[A-Za-z0-9@_.:-]{1,128}$", cfg["service"]):
        raise HelperError("helper.conf: invalid service name")
    if not re.match(r"^[A-Za-z0-9@_.:-]{1,128}$", cfg["portal_service"]):
        raise HelperError("helper.conf: invalid portal_service")
    if not re.match(r"^[A-Za-z0-9_-]{1,64}$", cfg["config_name"]):
        raise HelperError("helper.conf: invalid config_name")
    if not re.match(r"^[A-Za-z0-9_.-]{1,100}\.service$", cfg["update_check_unit"]):
        raise HelperError("helper.conf: invalid update_check_unit")
    if not re.match(r"^[A-Za-z0-9_-]{1,100}$", cfg["update_install_unit"]):
        raise HelperError("helper.conf: invalid update_install_unit")
    for key in ("integration_fetch_unit", "integration_install_unit", "integration_remove_unit"):
        if not re.match(r"^[A-Za-z0-9_-]{1,100}$", cfg[key]):
            raise HelperError("helper.conf: invalid %s" % key)
    for key in ("radius_port", "portal_port", "restart_wait", "restart_timeout", "validate_timeout",
                "lock_timeout", "keep_backups", "update_max_mib", "integration_max_mib"):
        try:
            cfg[key] = int(cfg[key])
        except ValueError:
            raise HelperError("helper.conf: %s must be an integer" % key)
    cfg["portal_verify_tls"] = cfg["portal_verify_tls"].lower() in ("1", "true", "yes", "on")
    if cfg["duo_api_connect"] and not re.fullmatch(r"127\.0\.0\.1:[0-9]{1,5}", cfg["duo_api_connect"]):
        raise HelperError("helper.conf: duo_api_connect must be 127.0.0.1:PORT (tests only) or empty")
    if cfg["duo_api_cafile"]:
        cfg["duo_api_cafile"] = _abs(cfg, "duo_api_cafile")
    if cfg["keep_backups"] < 1:
        raise HelperError("helper.conf: keep_backups must be >= 1")
    try:
        pw = pwd.getpwnam(cfg["freerad_user"])
        cfg["freerad_uid"] = pw.pw_uid
        cfg["freerad_gid"] = (grp.getgrnam(cfg["freerad_group"]).gr_gid
                              if cfg["freerad_group"] else pw.pw_gid)
        cfg["staging_uid"] = pwd.getpwnam(cfg["staging_owner"]).pw_uid
    except KeyError as e:
        raise HelperError("helper.conf: unknown user/group %s" % e)
    allowed = set()
    for name in cfg["allowed_users"].split(","):
        name = name.strip()
        if name:
            try:
                allowed.add(pwd.getpwnam(name).pw_uid)
            except KeyError:
                pass
    cfg["allowed_uids"] = allowed
    cfg["policy_target"] = os.path.join(cfg["raddb"], "policy.d", POLICY_NAME)
    cfg["clients_target"] = os.path.join(cfg["raddb"], CLIENTS_NAME)
    cfg["facility"] = _FACILITIES.get(cfg["syslog_facility"].lower(), syslog.LOG_AUTHPRIV)
    return cfg


# --------------------------------------------------------------------------- logging

def log(level, msg):
    try:
        syslog.syslog(level, msg.replace("\n", " ")[:2000])
    except Exception:
        pass


# --------------------------------------------------------------------------- subprocess

def run(argv, timeout, input_data=None):
    """Run a fixed program (argv[0] from config) with a clean env. Returns (rc, output)."""
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL if input_data is None else None,
                           input=input_data, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           env=SAFE_ENV, cwd="/", timeout=timeout, close_fds=True,
                           start_new_session=True)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode("utf-8", "replace")
        return 124, out + "\n[radius-admin-helper: %s timed out after %ss]" % (
            os.path.basename(argv[0]), timeout)
    except OSError as e:
        return 127, "[radius-admin-helper: cannot execute %s: %s]" % (argv[0], e.strerror)


_SECRET_LINE = re.compile(r'(?i)(\b(?:secret|password)\s*=\s*)(\S.*)$')


def tail(output, n=OUTPUT_LINES):
    lines = output.splitlines()[-n:]
    out = []
    for ln in lines:
        ln = _SECRET_LINE.sub(lambda m: m.group(1) + "<redacted>", ln)
        out.append(ln[:500])
    return "\n".join(out)


