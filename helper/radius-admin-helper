def act_validate(cfg, req):
    _, vroot = ensure_work_dirs(cfg)
    with Lock(cfg):
        policy, clients = read_staged(cfg)
        certs_raw = read_staged_certs(cfg)
        cert_files = check_certificates(cfg, certs_raw) if certs_raw is not None else {}
        duo = read_staged_duo(cfg)
        if duo is not None:
            if not _duo_ready(cfg):
                raise HelperError("a Duo configuration is staged, but the Duo Authentication Proxy is not installed")
            check_duo_config(duo, fips_on(cfg))
            check_duo_fips(cfg)
        ok, out, n = validate_candidate(cfg, vroot, policy, clients, cert_files)
    resp = {"ok": ok, "message": ("configuration valid (%d clients)" % n) if ok
            else "radiusd -XC reported errors", "output": out,
            "policy_sha256": sha256(policy), "clients_sha256": sha256(clients)}
    if duo is not None:
        resp["duo_sha256"] = sha256(duo)
    if certs_raw is not None:
        resp["certificates_sha256"] = sha256(certs_raw)
        resp["certificates_changed"] = sorted(cert_files)
    return resp


def check_duo_fips(cfg):
    """FIPS mode (SPEC section 29.4): a Duo configuration is installed only while the installed
    build was installed in FIPS mode and the signed catalog lists its SHA-256 as FIPS-capable and
    not withdrawn. A build installed before FIPS mode was turned on, or one the catalog does not
    (or no longer) mark FIPS-capable, keeps Duo out of FreeRADIUS until it is replaced."""
    if not fips_on(cfg):
        return
    inst = _installed(cfg, "duo")
    entry = next((e for e in load_catalog(cfg)["entries"]
                  if e["provider"] == "duo" and inst.get("sha256") and e["sha256"] == inst.get("sha256")), None)
    name = "the installed Duo Authentication Proxy" + ((" " + str(inst["version"])) if inst.get("version") else "")
    if entry is None or not entry["fips"] or entry["withdrawn"]:
        raise HelperError("FIPS mode: %s is not a FIPS-capable build in the signed catalog; turn the Duo provider"
                          " off and apply, or install a FIPS-capable build" % name)
    if inst.get("fips") is not True:
        raise HelperError("FIPS mode: %s was installed before FIPS mode was turned on (not a FIPS-capable build"
                          " install); install it again, or turn the Duo provider off and apply" % name)


def _duo_ready(cfg):
    return bool(_installed(cfg, "duo")) and os.path.isdir(os.path.join(cfg["duo_dir"], "conf"))


def install_duo_config(cfg, data):
    """authproxy.cfg, keeping the owner, group and mode the Duo installer gave it (the service
    user reads it); root:root 0640 when there is none yet."""
    path = duo_cfg_path(cfg)
    try:
        st = os.lstat(path)
        uid, gid, mode = st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode) & 0o640
    except FileNotFoundError:
        uid, gid, mode = 0, 0, 0o640
    atomic_write(path, data, uid, gid, mode or 0o600)


def restart_duo(cfg):
    prov = INTEGRATIONS["duo"]
    rc, out = run([cfg["systemctl"], "restart", prov["unit"]], cfg["restart_timeout"])
    deadline = time.monotonic() + cfg["restart_wait"]
    while True:
        active = unit_state(cfg, prov["unit"]) == "active"
        if active and _udp_bound(cfg, prov["listen"]):
            return True, "%s active and listening on %s" % (prov["unit"], prov["listen"])
        if time.monotonic() >= deadline:
            break
        time.sleep(0.5)
    if rc != 0:
        return False, "systemctl restart exited %d: %s" % (rc, tail(out, 5))
    return False, "%s not active" % prov["unit"] if not active else "%s not listening" % prov["listen"]


def _deploy(cfg, bdir, vroot, policy, clients, reason, extra, duo=None, cert_files=None):
    """Shared by apply and rollback: validate, back up, install, restart, auto-rollback.
    With `duo` (the Duo Authentication Proxy's configuration, SPEC section 29.2) that file is
    installed and the proxy restarted first; a failure of either service restores both."""
    if policy is None or clients is None:
        raise HelperError("both policy and clients files are required")
    if duo is not None:
        if not _duo_ready(cfg):
            raise HelperError("a Duo configuration is staged, but the Duo Authentication Proxy is not installed")
        check_duo_config(duo, fips_on(cfg))
        check_duo_fips(cfg)
    cert_files = cert_files or {}
    fr_certs = {k: v for k, v in cert_files.items() if k in FR_CERT_FILES}
    portal_certs = {k: v for k, v in cert_files.items() if k in PORTAL_CERT_FILES}
    ok, out, n = validate_candidate(cfg, vroot, policy, clients, fr_certs)
    if not ok:
        return dict(extra, ok=False, rolled_back=False, output=out,
                    message="validation failed; nothing changed")
    bid = make_backup(cfg, bdir, reason, duo_managed=duo is not None, cert_names=cert_files)
    prev = load_backup(bdir, bid)
    prev_fr = {k: v for k, v in prev["certs"].items() if k in FR_CERT_FILES}
    prev_portal = {k: v for k, v in prev["certs"].items() if k in PORTAL_CERT_FILES}
    if cert_files:
        extra = dict(extra, certificates_changed=sorted(cert_files))
    duo_changed = duo is not None and duo != prev.get("duo")
    duo_info = {"duo_sha256": sha256(duo)} if duo is not None else {}
    why_d = ""

    def restore_duo():
        if duo_changed and prev.get("duo") is not None:
            install_duo_config(cfg, prev["duo"])
            restart_duo(cfg)

    if duo_changed:
        try:
            install_duo_config(cfg, duo)
        except Exception as e:
            restore_duo()
            raise HelperError("installing the Duo configuration failed (%s); previous files restored" % e)
        started_d, why_d = restart_duo(cfg)
        if not started_d:
            log(syslog.LOG_ERR, "%s: duoauthproxy did not start (%s); restoring backup %s" % (reason, why_d, bid))
            restore_duo()
            return dict(extra, ok=False, rolled_back=True, rollback_ok=True, backup_id=bid, output=out,
                        message="the Duo Authentication Proxy did not start with the new configuration (%s);"
                                " its previous configuration was restored and FreeRADIUS was not changed" % why_d)
    def restore_fr():
        install_files(cfg, prev["policy"], prev["clients"])
        install_cert_files(cfg, prev_fr)

    try:
        install_files(cfg, policy, clients)
        install_cert_files(cfg, fr_certs)
    except Exception as e:
        restore_fr()
        restore_duo()
        raise HelperError("install failed (%s); previous files restored" % e)
    started, why = restart_and_wait(cfg)
    why_p = ""
    if started and portal_certs:
        # the portal's certificate files, checked by nginx -t before the reload and by looking at
        # what the reloaded portal serves; a failure restores everything this apply changed
        try:
            install_cert_files(cfg, portal_certs)
            good, why_p = portal_reload_and_check(cfg, portal_certs.get("portal_cert"))
        except Exception as e:
            good, why_p = False, str(e)
        if not good:
            log(syslog.LOG_ERR, "%s: portal failed (%s); restoring backup %s" % (reason, why_p, bid))
            install_cert_files(cfg, prev_portal)
            back, why3 = portal_reload_and_check(cfg, None)
            restore_fr()
            restore_duo()
            restarted, why2 = restart_and_wait(cfg)
            return dict(extra, ok=False, rolled_back=True, rollback_ok=restarted and back, backup_id=bid, output=out,
                        message="the portal did not take the new certificate files (%s); previous configuration"
                                " restored%s" % (why_p, "" if restarted and back else
                                                 " BUT NOT HEALTHY: " + "; ".join(x for x in (why2, why3) if x)))
    if started:
        cert_info = {"certificates_sha256": extra.pop("_certs_sha", None)} if "_certs_sha" in extra else {}
        return dict(extra, ok=True, rolled_back=False, backup_id=bid, output=out,
                    policy_sha256=sha256(policy), clients_sha256=sha256(clients), **duo_info, **cert_info,
                    message="%s; %s%s%s" % (reason, why, ("; " + why_d) if why_d else "",
                                            ("; " + why_p) if why_p else ""))
    log(syslog.LOG_ERR, "%s: restart failed (%s); restoring backup %s" % (reason, why, bid))
    restore_fr()
    restore_duo()
    restarted, why2 = restart_and_wait(cfg)
    return dict(extra, ok=False, rolled_back=True, rollback_ok=restarted, backup_id=bid,
                output=out, message="restart failed (%s); previous configuration restored%s"
                % (why, "" if restarted else " BUT SERVICE STILL NOT HEALTHY: " + why2))


def _record(cfg, action, resp):
    st = read_state(cfg)
    entry = {"at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
             "action": action, "ok": bool(resp.get("ok")),
             "backup_id": resp.get("backup_id"),
             "policy_sha256": resp.get("policy_sha256"),
             "clients_sha256": resp.get("clients_sha256"),
             "duo_sha256": resp.get("duo_sha256"),
             "certificates_sha256": resp.get("certificates_sha256"),
             "rolled_back": bool(resp.get("rolled_back")), "message": resp.get("message", "")}
    if resp.get("restored"):
        entry["restored"] = resp["restored"]
    st["last_attempt"] = entry
    if entry["ok"]:
        st["last_apply"] = entry
    write_state(cfg, st)


def act_apply(cfg, req):
    bdir, vroot = ensure_work_dirs(cfg)
    with Lock(cfg):
        policy, clients = read_staged(cfg)
        certs_raw = read_staged_certs(cfg)
        cert_files, extra = {}, {}
        if certs_raw is not None:
            cert_files = check_certificates(cfg, certs_raw)
            extra["_certs_sha"] = sha256(certs_raw)
        resp = _deploy(cfg, bdir, vroot, policy, clients, "apply", extra, duo=read_staged_duo(cfg),
                       cert_files=cert_files)
        resp.pop("_certs_sha", None)
        _record(cfg, "apply", resp)
        prune_backups(cfg, bdir)
    return resp


def act_rollback(cfg, req):
    bid = req.get("backup_id")
    if not isinstance(bid, str) or not BACKUP_ID_RE.match(bid):
        raise HelperError("invalid backup_id (expected YYYYMMDDTHHMMSSZ)")
    bdir, vroot = ensure_work_dirs(cfg)
    with Lock(cfg):
        files = load_backup(bdir, bid)
        # The Duo configuration in the backup is restored when radius-admin wrote it; Duo's own
        # sample (before the first apply that configured Duo) is not: the restored FreeRADIUS
        # files send nothing to Duo, so the current file stays (SPEC section 29.2).
        duo = files.get("duo") if files["duo_managed"] else None
        if duo is not None and not duo.startswith(b"; radius-admin"):
            duo = None
        # certificate files the backup holds (an apply that changed them) are put back as they were
        resp = _deploy(cfg, bdir, vroot, files["policy"], files["clients"],
                       "rollback to %s" % bid, {"restored": bid}, duo=duo, cert_files=files["certs"])
        _record(cfg, "rollback", resp)
        prune_backups(cfg, bdir, protect=(bid,))
    return resp


