# Lines matching any of these regexes are accepted by tools/site-scan.sh.
# Only generic, obviously fake test values and upstream FreeRADIUS comments belong here.
[^0-9.]10\.0\.0\.[0-9]{1,3}([^0-9]|$)
[^0-9.]10\.1\.1\.1([^0-9]|$)
[^0-9.]10\.9\.9\.9([^0-9]|$)
[^0-9.]10\.20\.0\.5([^0-9]|$)
172\.16\.0\.1"
mods-config/files/authorize:[0-9]+:#
mods-available/sql:[0-9]+:\s*#
mods-available/sql:[0-9]+:\s*certificate_password = "password"
mods-available/ldap:[0-9]+:\s*secret\s*= 'radiusClientSecret'
