#!/bin/sh
# radius-admin-freeradius prerm: stop radiusd only when the package is removed, not on
# upgrade (an upgrade replaces the binaries; the running daemon keeps serving until the
# next restart).
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop freeradius.service || true
    systemctl disable freeradius.service >/dev/null 2>&1 || true
fi
exit 0
