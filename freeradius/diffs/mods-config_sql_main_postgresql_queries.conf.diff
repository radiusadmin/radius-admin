 	# when used with the rlm_sql_null driver.
 #	logfile = ${logdir}/post-auth.sql
 
+	#
+	#  radius-admin: the stock query stored User-Password / CHAP-Password in
+	#  "pass".  Passwords are NEVER logged.  The radpostauth table has no
+	#  password column; it records the auth method set by policy.d/radius-admin
+	#  in &control:Tmp-String-1 ("eap-tls", "pap-admin", "mab"; else "other"),
+	#  the NAS and its port, the assigned VLAN, the client certificate (DNS SAN,
+	#  CN, subject, issuer, serial, expiry), the reject reason
+	#  (Module-Failure-Message), the computer's AD groups exactly as passed to the
+	#  rule matcher (hex list from &control:Tmp-String-3) and the access rule that
+	#  assigned the VLAN (&control:Tmp-String-6; stored only when it is digits).
+	#  This query runs for Access-Accept and (via Post-Auth-Type REJECT) for
+	#  Access-Reject.  All %{...} values are escaped by rlm_sql.
+	#
 	query = "\
 		INSERT INTO ${..postauth_table} \
-			(username, pass, reply, authdate ${..class.column_name}) \
+			(username, reply, authmethod, nasipaddress, calledstationid, \
+			 callingstationid, nasporttype, vlan, certsan, authdate, \
+			 reason, nasportid, cert_cn, cert_subject, cert_issuer, cert_serial, cert_expiry, \
+			 ad_groups_hex, rule_id ${..class.column_name}) \
 		VALUES(\
 			'%{User-Name}', \
-			'%{%{User-Password}:-%{Chap-Password}}', \
 			'%{reply:Packet-Type}', \
-			'%S.%M' \
+			'%{%{control:Tmp-String-1}:-other}', \
+			NULLIF('%{%{NAS-IPv6-Address}:-%{%{NAS-IP-Address}:-%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}}}', '')::inet, \
+			NULLIF('%{Called-Station-Id}', ''), \
+			NULLIF('%{Calling-Station-Id}', ''), \
+			NULLIF('%{NAS-Port-Type}', ''), \
+			NULLIF('%{reply:Tunnel-Private-Group-Id}', ''), \
+			NULLIF('%{TLS-Client-Cert-Subject-Alt-Name-Dns}', ''), \
+			TO_TIMESTAMP(%l.%M), \
+			NULLIF(left('%{Module-Failure-Message}', 500), ''), \
+			NULLIF(left('%{NAS-Port-Id}', 100), ''), \
+			NULLIF(left('%{TLS-Client-Cert-Common-Name}', 300), ''), \
+			NULLIF(left('%{TLS-Client-Cert-Subject}', 1000), ''), \
+			NULLIF(left('%{TLS-Client-Cert-Issuer}', 1000), ''), \
+			NULLIF(left('%{TLS-Client-Cert-Serial}', 100), ''), \
+			NULLIF(left('%{TLS-Client-Cert-Expiration}', 40), ''), \
+			NULLIF(left('%{control:Tmp-String-3}', 20000), ''), \
+			substring('%{control:Tmp-String-6}' from '^[0-9]{1,9}$')::integer \
 			${..class.reply_xlat})"
 }
